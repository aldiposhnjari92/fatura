---
import AppLayout from '@/layouts/AppLayout.astro';
import Checkout from '@/components/react/Checkout';
import { Icon } from '@/components/ui/icon';
import { formatALL, formatDate } from '@/lib/utils';
import {
  PLAN_OPTIONS,
  getBankDetails,
  getMethods,
  isBankConfigured,
  isPaypalConfigured,
} from '@/lib/payments';

export const prerender = false;

const { supabase, user, profile } = Astro.locals;

// Term chosen on the pricing page, carried here through signup.
const requestedMonths = Number.parseInt(Astro.url.searchParams.get('muaj') ?? '', 10);
const initialMonths = PLAN_OPTIONS.some((o) => o.months === requestedMonths)
  ? requestedMonths
  : 1;
const fromSignup = Astro.url.searchParams.has('muaj');

// import.meta.env is server-side here; only PUBLIC_* reaches the browser, and
// the PayPal *secret* is never passed to the island.
const env = import.meta.env as unknown as Record<string, unknown>;
const methods = getMethods(env);
const bank = getBankDetails(env);
const bankConfigured = isBankConfigured(env);
const paypalClientId = isPaypalConfigured(env)
  ? String(env.PUBLIC_PAYPAL_CLIENT_ID)
  : null;

const [bootstrapResult, historyResult] = await Promise.all([
  supabase.rpc('app_bootstrap'),
  supabase
    .from('payments')
    .select('id, reference, method, amount, months, status, created_at, decided_at')
    .eq('owner_id', user!.id)
    .order('created_at', { ascending: false })
    .limit(10),
]);

const bootstrap = (bootstrapResult.data ?? {}) as Record<string, any>;
const proActive = Boolean(bootstrap.pro_active);
const pending = bootstrap.pending_payment ?? null;
const history = (historyResult.data ?? []) as {
  id: string;
  reference: string;
  method: string;
  amount: number;
  months: number;
  status: string;
  created_at: string;
  decided_at: string | null;
}[];

const METHOD_LABEL: Record<string, string> = {
  bank_transfer: 'Transfertë bankare',
  card: 'Kartë',
  paypal: 'PayPal',
};
const STATUS_LABEL: Record<string, { label: string; className: string }> = {
  pending: { label: 'Në pritje', className: 'bg-amber-100 text-amber-900 dark:bg-amber-400/15 dark:text-amber-200' },
  confirmed: { label: 'E konfirmuar', className: 'bg-teal-100 text-teal-900 dark:bg-brand/20 dark:text-brand' },
  rejected: { label: 'E refuzuar', className: 'bg-red-100 text-red-900 dark:bg-red-400/15 dark:text-red-200' },
  refunded: { label: 'E rimbursuar', className: 'bg-slate-200 text-slate-700 dark:bg-white/10 dark:text-slate-200' },
};
---

<AppLayout title="Abonimi — Fatura.co" active="settings">
  <div class="mb-6">
    <p class="text-muted-foreground text-sm font-medium">Abonimi</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">
      {proActive ? 'Plani Pro' : 'Kalo në Pro'}
    </h1>
    <p class="text-muted-foreground mt-1 text-sm">
      Fatura të palimituara për 990 Lekë në muaj. Anulo kur të duash.
    </p>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]">
    <Checkout
      methods={methods}
      bank={bank}
      bankConfigured={bankConfigured}
      paypalClientId={paypalClientId}
      pending={pending}
      proActive={proActive}
      proUntil={profile?.pro_until ?? null}
      initialMonths={initialMonths}
      fromSignup={fromSignup}
      client:load
    />

    <aside class="flex flex-col gap-6">
      <section class="bg-card ring-border rounded-xl p-5 ring-1">
        <h2 class="text-sm font-semibold">Çfarë përfshin Pro</h2>
        <ul class="mt-4 flex flex-col gap-3 text-sm">
          {
            [
              'Fatura të palimituara',
              'Gjithçka nga plani falas',
              'Mbështetje me përparësi në WhatsApp',
              'Veçoritë e reja të parët',
            ].map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="bg-accent text-primary mt-px flex size-5 shrink-0 items-center justify-center rounded-full">
                  <Icon name="check" class="size-3.5" />
                </span>
                <span class="text-foreground/85">{item}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        history.length > 0 && (
          <section class="bg-card ring-border overflow-hidden rounded-xl ring-1">
            <h2 class="border-b px-5 py-4 text-sm font-semibold">Historiku i pagesave</h2>
            <ul class="divide-y">
              {history.map((p) => {
                const meta = STATUS_LABEL[p.status] ?? STATUS_LABEL.pending;
                return (
                  <li class="flex items-center justify-between gap-3 px-5 py-3">
                    <div class="min-w-0">
                      <p class="font-mono text-xs">{p.reference}</p>
                      <p class="text-muted-foreground mt-0.5 text-xs">
                        {METHOD_LABEL[p.method] ?? p.method} · {formatDate(p.created_at)}
                      </p>
                    </div>
                    <div class="shrink-0 text-right">
                      <p class="text-sm font-medium tabular-nums">{formatALL(p.amount)}</p>
                      <span
                        class={`mt-0.5 inline-block rounded-full px-2 py-0.5 text-[10px] font-semibold ${meta.className}`}
                      >
                        {meta.label}
                      </span>
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        )
      }

      <section class="border-primary/25 bg-accent/40 rounded-xl border p-5">
        <div class="flex items-start gap-2.5">
          <Icon name="shield-check" class="text-primary mt-0.5 size-4 shrink-0" />
          <p class="text-muted-foreground text-xs leading-relaxed">
            Nuk ruajmë të dhëna kartash. Transfertat bankare konfirmohen manualisht nga
            ne; pagesat me kartë ose PayPal procesohen nga ofruesi, jo nga serverët tanë.
          </p>
        </div>
      </section>
    </aside>
  </div>
</AppLayout>
