---
import AppLayout from '@/layouts/AppLayout.astro';
import SuppliesManager from '@/components/react/SuppliesManager';
import { hasFeature } from '@/lib/features';
import type { Supplier, Supply } from '@/models/supplier';

export const prerender = false;

const { supabase, user, profile } = Astro.locals;

// Only for accounts with the feature on; RLS refuses the rows otherwise anyway.
if (!hasFeature(profile, 'suppliers')) {
  return Astro.redirect('/app', 302);
}

const [suppliesResult, suppliersResult] = await Promise.all([
  supabase
    .from('supplies')
    .select('*')
    .eq('owner_id', user!.id)
    .order('supply_date', { ascending: false })
    .order('created_at', { ascending: false })
    .limit(500),
  supabase
    .from('suppliers')
    .select('id, name, description')
    .eq('owner_id', user!.id)
    .order('name')
    .limit(500),
]);

const supplies = (suppliesResult.data ?? []) as Supply[];
const suppliers = (suppliersResult.data ?? []) as Pick<Supplier, 'id' | 'name' | 'description'>[];
---

<AppLayout title="Furnizimet — Fatura.co" active="supplies">
  <div class="mb-6">
    <p class="text-muted-foreground text-sm font-medium">Furnizimet</p>
    <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">
      {supplies.length} {supplies.length === 1 ? 'furnizim' : 'furnizime'}
    </h1>
    <p class="text-muted-foreground mt-1 text-sm">
      Malli që ke blerë, nga kush, dhe sa u ke ende borxh furnitorëve.
    </p>
  </div>

  <SuppliesManager supplies={supplies} suppliers={suppliers} client:load />
</AppLayout>
