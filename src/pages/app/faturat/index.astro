---
import TableSort from '@/components/TableSort.astro';
import PaidToggle from '@/components/react/PaidToggle';
import AppLayout from '@/layouts/AppLayout.astro';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Icon } from '@/components/ui/icon';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table';
import { formatALL, formatDate } from '@/lib/utils';
import type { InvoiceStatus, InvoiceWithClient } from '@/lib/types';
import { applyInvoiceSearch, matchingClientIds, normalizeQuery } from '@/lib/search';

export const prerender = false;

const { supabase, user } = Astro.locals;
const params = Astro.url.searchParams;

const VALID_STATUSES: InvoiceStatus[] = ['draft', 'unpaid', 'paid', 'overdue'];
const rawStatus = params.get('statusi');
const status = VALID_STATUSES.includes(rawStatus as InvoiceStatus)
  ? (rawStatus as InvoiceStatus)
  : null;
const search = normalizeQuery(params.get('kerko'));

const PAGE_SIZE = 25;
const page = Math.max(1, Number.parseInt(params.get('faqe') ?? '1', 10) || 1);
const from = (page - 1) * PAGE_SIZE;

/*
  Paged and column-scoped. This previously pulled 200 rows with `select('*')`,
  dragging the whole `items` JSONB of every invoice across the wire to render a
  table that never displays it.
*/

let query = supabase
  .from('invoices')
  .select('id, invoice_number, issue_date, due_date, total, status, paid_at, clients(name)', {
    count: 'exact',
  })
  .eq('owner_id', user!.id)
  .order('issue_date', { ascending: false })
  .order('created_at', { ascending: false })
  .range(from, from + PAGE_SIZE - 1);

/*
  `overdue` is no longer a value anyone stores — it is "unpaid, and the due
  date has passed". Filtering has to express that condition rather than compare
  against a status that will never be found in the column.
*/
if (status === 'overdue') {
  query = query
    .eq('status', 'unpaid')
    .not('due_date', 'is', null)
    .lt('due_date', new Date().toISOString().slice(0, 10));
} else if (status) {
  query = query.eq('status', status);
}
/*
  Matches the invoice number *or* the client it is billed to — the same rule
  the shell's global search uses, so a term typed up there and then narrowed
  here does not silently change meaning. `matchingClientIds` runs only when
  there is a term to match.
*/
const searchClientIds = search ? await matchingClientIds(supabase, user!.id, search) : [];
query = applyInvoiceSearch(query, search, searchClientIds);

const { data, error, count } = await query;
const invoices = (data ?? []) as unknown as InvoiceWithClient[];
const total = count ?? 0;
const pageCount = Math.max(1, Math.ceil(total / PAGE_SIZE));

const filters: { label: string; value: InvoiceStatus | null }[] = [
  { label: 'Të gjitha', value: null },
  { label: 'Draft', value: 'draft' },
  { label: 'Të papaguara', value: 'unpaid' },
  { label: 'Të paguara', value: 'paid' },
  { label: 'Të vonuara', value: 'overdue' },
];

const buildHref = (next: Partial<{ statusi: string; kerko: string; faqe: number }>) => {
  const qs = new URLSearchParams();
  const s = next.statusi !== undefined ? next.statusi : (status ?? '');
  const k = next.kerko !== undefined ? next.kerko : search;
  const f = next.faqe !== undefined ? next.faqe : page;
  if (s) qs.set('statusi', s);
  if (k) qs.set('kerko', k);
  if (f > 1) qs.set('faqe', String(f));
  const str = qs.toString();
  return str ? `/app/faturat?${str}` : '/app/faturat';
};


const pageTotal = invoices.reduce((sum, invoice) => sum + (invoice.total ?? 0), 0);
const hasFilter = Boolean(status || search);
---

<AppLayout title="Faturat — Fatura.co" active="invoices">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-muted-foreground text-sm font-medium">Faturat</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">
        {total} {total === 1 ? 'faturë' : 'fatura'}
      </h1>
      {
        invoices.length > 0 && (
          <p class="text-muted-foreground mt-1 text-sm">
            {formatALL(pageTotal)} në këtë faqe
          </p>
        )
      }
    </div>

    <Button as="a" href="/app/faturat/e-re">
      <Icon name="plus" /> Faturë e re
    </Button>
  </div>

  <!-- Toolbar -->
  <div
    class="bg-card shadow-card mb-4 flex flex-col gap-3 rounded-2xl p-3 lg:flex-row lg:items-center lg:justify-between"
  >
    <div class="flex flex-wrap gap-1.5">
      {
        filters.map((filter) => (
          <Button
            as="a"
            href={buildHref({ statusi: filter.value ?? '', faqe: 1 })}
            size="sm"
            variant={status === filter.value ? 'default' : 'ghost'}
          >
            {filter.label}
          </Button>
        ))
      }
    </div>

    <form method="GET" action="/app/faturat" class="flex gap-2">
      {status && <input type="hidden" name="statusi" value={status} />}
      <div class="relative flex-1 lg:w-64">
        <Icon
          name="search"
          class="text-muted-foreground pointer-events-none absolute top-1/2 left-2.5 size-4 -translate-y-1/2"
        />
        <Input
          type="search"
          name="kerko"
          value={search}
          placeholder="Kërko numrin e faturës…"
          class="pl-8"
        />
      </div>
      <Button type="submit" variant="outline" class="shrink-0">Kërko</Button>
      {
        hasFilter && (
          <Button as="a" href="/app/faturat" variant="ghost" class="shrink-0">
            Pastro
          </Button>
        )
      }
    </form>
  </div>

  {
    error && (
      <p class="border-destructive/30 bg-destructive/10 text-destructive rounded-lg border px-4 py-3 text-sm">
        Nuk u ngarkuan faturat: {error.message}
      </p>
    )
  }

  {
    invoices.length === 0 ? (
      <div class="bg-card shadow-card rounded-2xl px-6 py-16 text-center">
        <div class="bg-muted mx-auto flex size-12 items-center justify-center rounded-full">
          <Icon name="file-text" class="text-muted-foreground size-5" />
        </div>
        <h2 class="mt-4 text-sm font-semibold">
          {hasFilter ? 'Asnjë faturë nuk përputhet' : 'Ende asnjë faturë'}
        </h2>
        <p class="text-muted-foreground mx-auto mt-1 max-w-sm text-sm">
          {hasFilter
            ? 'Provo një filtër tjetër ose pastro kërkimin.'
            : 'Krijo faturën e parë — të merr më pak se 2 minuta.'}
        </p>
        <Button as="a" href={hasFilter ? '/app/faturat' : '/app/faturat/e-re'} class="mt-5">
          {hasFilter ? 'Pastro filtrat' : 'Krijo faturën e parë'}
        </Button>
      </div>
    ) : (
      <div class="bg-card shadow-card overflow-hidden rounded-2xl">
        {/*
          Same reasoning as the dashboard: below `sm` the table becomes one row
          per invoice, because six columns on a 360px screen wraps the number
          across three lines and pushes the status off the edge. Sorting stays
          reachable on mobile through the controls above the list.
        */}
        <ul class="divide-y sm:hidden">
          {invoices.map((invoice) => (
            <li class="flex items-center justify-between gap-3 px-4 py-3">
              <a href={`/app/faturat/${invoice.id}`} class="min-w-0 flex-1">
                <span class="text-primary block truncate font-medium">
                  {invoice.invoice_number}
                </span>
                <span class="text-muted-foreground block truncate text-xs">
                  {invoice.clients?.name ?? '—'} · {formatDate(invoice.issue_date)}
                </span>
              </a>
              <span class="flex shrink-0 flex-col items-end gap-1">
                <span class="font-medium whitespace-nowrap tabular-nums">
                  {formatALL(invoice.total)}
                </span>
                <PaidToggle
                  client:visible
                  invoiceId={invoice.id}
                  status={invoice.status}
                  paidAt={invoice.paid_at}
                  dueDate={invoice.due_date}
                  showBadge
                />
              </span>
            </li>
          ))}
        </ul>

        <Table containerClass="hidden sm:block" data-sortable>
          <TableHeader>
            <TableRow>
              <TableHead sortKey="numri">Numri</TableHead>
              {/* Now sortable too: the client name is already in the DOM, so
                  the join that blocked SQL ordering is irrelevant here. */}
              <TableHead sortKey="klienti">Klienti</TableHead>
              <TableHead class="hidden sm:table-cell" sortKey="data" sortType="date">
                Lëshuar
              </TableHead>
              <TableHead class="hidden md:table-cell" sortKey="afati" sortType="date">
                Afati
              </TableHead>
              <TableHead class="text-right" sortKey="totali" sortType="number">
                Totali
              </TableHead>
              <TableHead class="text-right" sortKey="statusi">Statusi</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {invoices.map((invoice) => (
              <TableRow>
                <TableCell>
                  <a
                    href={`/app/faturat/${invoice.id}`}
                    class="text-primary font-medium hover:underline"
                  >
                    {invoice.invoice_number}
                  </a>
                </TableCell>
                <TableCell class="max-w-[18rem] truncate">
                  {invoice.clients?.name ?? '—'}
                </TableCell>
                <TableCell class="text-muted-foreground hidden sm:table-cell">
                  {formatDate(invoice.issue_date)}
                </TableCell>
                <TableCell class="text-muted-foreground hidden md:table-cell">
                  {formatDate(invoice.due_date)}
                </TableCell>
                <TableCell class="text-right font-medium tabular-nums">
                  {formatALL(invoice.total)}
                </TableCell>
                <TableCell class="text-right">
                  {/* Badge and action are one island, so they can never
                      disagree after a click. */}
                  <PaidToggle
                    client:visible
                    invoiceId={invoice.id}
                    status={invoice.status}
                    paidAt={invoice.paid_at}
                    dueDate={invoice.due_date}
                    showBadge
                  />
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>

        {
          pageCount > 1 && (
            <div class="flex items-center justify-between border-t px-5 py-3">
              <p class="text-muted-foreground text-sm">
                Faqja {page} nga {pageCount}
              </p>
              <div class="flex gap-2">
                <Button
                  as="a"
                  href={buildHref({ faqe: page - 1 })}
                  size="sm"
                  variant="outline"
                  aria-disabled={page <= 1}
                  class={page <= 1 ? 'pointer-events-none opacity-50' : ''}
                >
                  <Icon name="chevron-left" /> Para
                </Button>
                <Button
                  as="a"
                  href={buildHref({ faqe: page + 1 })}
                  size="sm"
                  variant="outline"
                  aria-disabled={page >= pageCount}
                  class={page >= pageCount ? 'pointer-events-none opacity-50' : ''}
                >
                  Pas <Icon name="chevron-right" />
                </Button>
              </div>
            </div>
          )
        }
      </div>
    )
  }
  <TableSort />
</AppLayout>
