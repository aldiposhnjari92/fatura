---
import { useTranslations } from '@/lib/i18n';
import AppLayout from '@/layouts/AppLayout.astro';
import InvoiceEditor from '@/components/react/InvoiceEditor';
import DeleteInvoiceButton from '@/components/react/DeleteInvoiceButton';
import InvoiceFileActions from '@/components/react/InvoiceFileActions';
import InvoiceDetail from '@/components/InvoiceDetail.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { Icon } from '@/components/ui/icon';
import { displayStatus } from '@/lib/invoices';
import { hasFeature } from '@/lib/features';
import { formatALL, formatDate } from '@/lib/utils';
import { suggestInvoiceNumber } from '@/lib/invoice-number';
import { suggestProducts } from '@/lib/products';
import type { Client } from '@/models/client';
import type { Invoice, InvoiceWithClient } from '@/models/invoice';

export const prerender = false;

const { supabase, user, profile } = Astro.locals;
const { id } = Astro.params;

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
if (!id || !UUID_RE.test(id)) {
  return Astro.redirect('/app/faturat', 302);
}

// RLS already scopes this to the owner; the explicit filter keeps it obvious.
const { data: invoiceRow } = await supabase
  .from('invoices')
  .select('*, clients(id, name, email, nipt, address)')
  .eq('id', id)
  .eq('owner_id', user!.id)
  .maybeSingle();

if (!invoiceRow) {
  return Astro.redirect('/app/faturat?gabim=nuk-u-gjet', 302);
}

const { clients: invoiceClient, ...invoiceFields } = invoiceRow as InvoiceWithClient;
const invoice = invoiceFields as Invoice;

/*
  A paid invoice is final (sync_invoice_paid_at), so it opens as a document
  rather than a form — and skips the three queries only the editor needs.
*/
const isPaid = invoice.status === 'paid';

const [{ data: clientsData }, suggestedNumber, products] = isPaid
  ? [{ data: [] }, '', []]
  : await Promise.all([
      supabase.from('clients').select('*').eq('owner_id', user!.id).order('name'),
      suggestInvoiceNumber(supabase, user!.id),
      suggestProducts(supabase, user!.id),
    ]);

const clients = (clientsData ?? []) as Client[];
const t = useTranslations();
---

<AppLayout title={`${invoice.invoice_number} — Fatura.co`} active="invoices">
  {/* Mirrors the new-invoice header, plus the two facts you open a saved
      invoice to check: what state it is in, and for how much. */}
  <div class="mb-5">
    <a
      href="/app/faturat"
      class="text-muted-foreground hover:text-foreground inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
    >
      <Icon name="arrow-left" class="size-4" />
      {t('inv.title')}
    </a>

    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-2xl font-bold tracking-[-0.03em] sm:text-3xl">
            {invoice.invoice_number}
          </h1>
          <StatusBadge status={displayStatus(invoice.status, invoice.due_date)} />
        </div>
        {
          isPaid ? (
            // Who and when; the summary card below carries the amount.
            <p class="text-muted-foreground mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
              {invoiceClient?.name && (
                <span class="inline-flex items-center gap-1.5">
                  <Icon name="building-2" class="size-4" />
                  {invoiceClient.name}
                </span>
              )}
              <span class="inline-flex items-center gap-1.5">
                <Icon name="calendar" class="size-4" />
                Lëshuar më {formatDate(invoice.issue_date)}
              </span>
            </p>
          ) : (
            <p class="text-muted-foreground mt-1 text-sm">
              Lëshuar më {formatDate(invoice.issue_date)} ·
              <span class="text-foreground font-medium tabular-nums">
                {formatALL(invoice.total)}
              </span>
            </p>
          )
        }
      </div>

      {
        // A paid invoice is read-only (0019) but can still be deleted (0020).
        isPaid ? (
          <div class="flex items-center gap-2">
            <DeleteInvoiceButton
              invoiceId={invoice.id}
              invoiceNumber={invoice.invoice_number}
              client:idle
            />
            <InvoiceFileActions
              invoiceId={invoice.id}
              invoiceNumber={invoice.invoice_number}
              allowExcel={hasFeature(profile, 'excel')}
              client:idle
            />
          </div>
        ) : (
          <DeleteInvoiceButton
            invoiceId={invoice.id}
            invoiceNumber={invoice.invoice_number}
            client:idle
          />
        )
      }
    </div>
  </div>

  {
    isPaid ? (
      <InvoiceDetail invoice={invoice} client={invoiceClient} />
    ) : (
      <InvoiceEditor
        profile={profile}
        clients={clients}
        invoice={invoice}
        suggestedNumber={suggestedNumber}
        products={products}
        client:load
      />
    )
  }
</AppLayout>
