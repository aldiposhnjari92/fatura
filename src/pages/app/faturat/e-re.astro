---
import { useTranslations } from '@/lib/i18n';
import AppLayout from '@/layouts/AppLayout.astro';
import InvoiceEditor from '@/components/react/InvoiceEditor';
import { suggestInvoiceNumber } from '@/lib/invoice-number';
import type { Client } from '@/lib/types';
import { quotaReached } from '@/lib/plans';

export const prerender = false;

const { supabase, user, profile, plan } = Astro.locals;

const now = new Date();
const monthStart = new Date(now.getFullYear(), now.getMonth(), 1).toISOString();

const [clientsResult, monthResult, suggestedNumber] = await Promise.all([
  supabase.from('clients').select('*').eq('owner_id', user!.id).order('name'),
  supabase
    .from('invoices')
    .select('id', { count: 'exact', head: true })
    .eq('owner_id', user!.id)
    .gte('created_at', monthStart),
  suggestInvoiceNumber(supabase, user!.id),
]);

const clients = (clientsResult.data ?? []) as Client[];
const invoicesThisMonth = monthResult.count ?? 0;
// Same rule as enforce_invoice_quota(): the cap is the active tier's, and Pro
// has none. This only warns — the database is what actually refuses the insert.
const limitReached = quotaReached(plan, invoicesThisMonth);
const t = useTranslations();
---

<AppLayout title={`${t('inv.new')} — Fatura.co`} active="invoices">
  <div class="mb-6 flex items-center gap-3">
    <a
      href="/app/faturat"
      class="text-sm font-medium text-muted-foreground hover:text-foreground"
      >← {t('inv.title')}</a
    >
  </div>

  <h1 class="mb-6 text-2xl font-bold tracking-tight sm:text-3xl">{t('inv.new')}</h1>

  <InvoiceEditor
    profile={profile}
    clients={clients}
    suggestedNumber={suggestedNumber}
    limitReached={limitReached}
    client:load
  />
</AppLayout>
