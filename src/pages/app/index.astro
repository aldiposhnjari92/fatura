---
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { displayStatus } from '@/lib/types';
import { Button } from '@/components/ui/button';
import { Icon } from '@/components/ui/icon';
import { formatALL, formatDate } from '@/lib/utils';
import type { InvoiceWithClient } from '@/lib/types';
import { PLANS, planOf, quotaReached, usageRatio } from '@/lib/plans';

export const prerender = false;

const { supabase, user, profile, invoicesThisMonth, plan, invoiceLimit } =
  Astro.locals;

/*
  Two round trips, both bounded:
    1. dashboard_stats() — every total summed in Postgres, one row back.
       This used to select *every invoice the user had ever created* and sum
       them in JS, so payload grew without limit.
    2. the five most recent invoices, selecting only the columns rendered
       (notably NOT the items JSONB, which is dead weight in a list).
*/
const [statsResult, recentResult] = await Promise.all([
  supabase.rpc('dashboard_stats'),
  supabase
    .from('invoices')
    .select('id, invoice_number, issue_date, due_date, total, status, clients(name)')
    .eq('owner_id', user!.id)
    .order('created_at', { ascending: false })
    .limit(5),
]);

const stats = (statsResult.data ?? {}) as Record<string, number>;
const recent = (recentResult.data ?? []) as unknown as InvoiceWithClient[];

/*
  The meter follows the tier in force, not a boolean: free caps at 5, Starter
  at 30, Pro not at all. `invoiceLimit` is null exactly when it is unlimited.
*/
const planSpec = planOf(plan);
const unlimited = invoiceLimit === null;
const usedPct = usageRatio(plan, invoicesThisMonth) * 100;
const limitReached = quotaReached(plan, invoicesThisMonth);

const monthTotal = Number(stats.month_total ?? 0);
const prevMonthTotal = Number(stats.prev_month_total ?? 0);
const delta =
  prevMonthTotal > 0
    ? Math.round(((monthTotal - prevMonthTotal) / prevMonthTotal) * 100)
    : null;

const kpis = [
  {
    label: 'Faturuar këtë muaj',
    value: formatALL(monthTotal),
    icon: 'trending-up',
    delta
  },
  {
    label: 'Të arkëtuara',
    value: formatALL(Number(stats.paid_total ?? 0)),
    icon: 'circle-check-big',
    tone: 'text-success',
  },
  {
    label: "Për t'u arkëtuar",
    value: formatALL(Number(stats.outstanding_total ?? 0)),
    icon: 'clock',
    tone: 'text-warning',
    hint:
      Number(stats.overdue_count ?? 0) > 0
        ? `${stats.overdue_count} të vonuara`
        : undefined,
  },
  {
    label: 'Klientë',
    value: String(stats.client_count ?? 0),
    icon: 'users',
  },
];

// Use the whole business name — splitting on whitespace turns
// "Bar Kafe Vlora" into "Bar".
const businessName = profile?.business_name?.trim() ?? '';
---

<AppLayout title="Paneli — Fatura.co" active="dashboard">
  <!-- Page header -->
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-muted-foreground text-sm font-medium">Paneli</p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">
        Mirë se erdhe{businessName ? `, ${businessName}` : ''}
      </h1>
    </div>

    <div class="flex items-center gap-2">
      <Button as="a" href="/app/klientet" variant="outline">
        <Icon name="users" /> Klientët
      </Button>
      <Button as="a" href="/app/faturat/e-re">
        <Icon name="plus" /> Faturë e re
      </Button>
    </div>
  </div>

  {
    limitReached && (
      <div class="border-warning/40 bg-warning/10 mb-6 flex flex-wrap items-center justify-between gap-4 rounded-xl border px-5 py-4">
        <div class="flex items-start gap-3">
          <Icon name="triangle-alert" class="text-warning mt-0.5 shrink-0" />
          <div>
            <p class="text-sm font-semibold">Ke mbaruar faturat falas për këtë muaj</p>
            <p class="text-muted-foreground mt-0.5 text-sm">
              Kalo në planin Pro për fatura të palimituara, ose prit muajin tjetër.
            </p>
          </div>
        </div>
        <Button as="a" href="/app/abonimi" size="sm">Shiko planin Pro</Button>
      </div>
    )
  }

  <!-- KPI row -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      kpis.map((kpi) => (
        <div class="bg-card ring-border rounded-xl p-5 ring-1">
          <div class="flex items-center justify-between">
            <p class="text-muted-foreground text-xs font-medium tracking-wide uppercase">
              {kpi.label}
            </p>
            <Icon name={kpi.icon} class="text-muted-foreground/60 size-4" />
          </div>

          <p class={`mt-3 text-2xl font-semibold tracking-tight tabular-nums ${kpi.tone ?? ''}`}>
            {kpi.value}
          </p>

          <div class="mt-1.5 flex items-center gap-1.5 text-xs">
            {
              kpi.delta !== null && kpi.delta !== undefined && (
                <span
                  class:list={[
                    'inline-flex items-center gap-0.5 rounded-full px-1.5 py-0.5 font-semibold',
                    kpi.delta >= 0
                      ? 'bg-success/10 text-success'
                      : 'bg-destructive/10 text-destructive',
                  ]}
                >
                  {kpi.delta >= 0 ? '↑' : '↓'} {Math.abs(kpi.delta)}%
                </span>
              )
            }
            {kpi.hint && <span class="text-muted-foreground">{kpi.hint}</span>}
          </div>
        </div>
      ))
    }
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_320px]">
    <!-- Recent invoices -->
    <section class="bg-card ring-border overflow-hidden rounded-xl ring-1">
      <div class="flex items-center justify-between border-b px-5 py-4">
        <h2 class="text-sm font-semibold">Faturat e fundit</h2>
        <a
          href="/app/faturat"
          class="text-primary text-sm font-medium hover:underline"
        >
          Shiko të gjitha
        </a>
      </div>

      {
        recent.length === 0 ? (
          <div class="px-5 py-14 text-center">
            <div class="bg-muted mx-auto flex size-12 items-center justify-center rounded-full">
              <Icon name="file-text" class="text-muted-foreground size-5" />
            </div>
            <h3 class="mt-4 text-sm font-semibold">Ende asnjë faturë</h3>
            <p class="text-muted-foreground mx-auto mt-1 max-w-xs text-sm">
              Krijo faturën e parë — të merr më pak se 2 minuta.
            </p>
            <Button as="a" href="/app/faturat/e-re" class="mt-5">
              Krijo faturën e parë
            </Button>
          </div>
        ) : (
          <>
            {/*
              A four-column table cannot fit a 360px screen: the invoice number
              broke across three lines and the status column fell off the right
              edge. Below `sm` each invoice is one scannable row instead —
              identity on the left, money on the right — and the table returns
              once there is width for it.
            */}
            <ul class="divide-y sm:hidden">
              {recent.map((invoice) => (
                <a
                  href={`/app/faturat/${invoice.id}`}
                  class="hover:bg-muted/40 flex items-center justify-between gap-3 px-4 py-3 transition-colors"
                >
                  <span class="min-w-0 flex-1">
                    <span class="text-primary block truncate font-medium">
                      {invoice.invoice_number}
                    </span>
                    <span class="text-muted-foreground block truncate text-xs">
                      {invoice.clients?.name ?? '—'} · {formatDate(invoice.issue_date)}
                    </span>
                  </span>
                  <span class="flex shrink-0 flex-col items-end gap-1">
                    <span class="font-medium whitespace-nowrap tabular-nums">
                      {formatALL(invoice.total)}
                    </span>
                    <StatusBadge status={displayStatus(invoice.status, invoice.due_date)} />
                  </span>
                </a>
              ))}
            </ul>

            <div class="hidden overflow-x-auto sm:block">
            <table class="w-full text-sm">
              <thead>
                <tr class="border-b">
                  <th class="text-muted-foreground px-5 py-2.5 text-left text-xs font-medium">
                    Numri
                  </th>
                  <th class="text-muted-foreground px-5 py-2.5 text-left text-xs font-medium">
                    Klienti
                  </th>
                  <th class="text-muted-foreground hidden px-5 py-2.5 text-left text-xs font-medium sm:table-cell">
                    Data
                  </th>
                  <th class="text-muted-foreground px-5 py-2.5 text-right text-xs font-medium">
                    Totali
                  </th>
                  <th class="text-muted-foreground px-5 py-2.5 text-right text-xs font-medium">
                    Statusi
                  </th>
                </tr>
              </thead>
              <tbody class="divide-y">
                {recent.map((invoice) => (
                  <tr class="hover:bg-muted/40 transition-colors">
                    <td class="px-5 py-3">
                      <a
                        href={`/app/faturat/${invoice.id}`}
                        class="text-primary font-medium whitespace-nowrap hover:underline"
                      >
                        {invoice.invoice_number}
                      </a>
                    </td>
                    <td class="max-w-[16rem] truncate px-5 py-3">
                      {invoice.clients?.name ?? '—'}
                    </td>
                    <td class="text-muted-foreground hidden px-5 py-3 sm:table-cell">
                      {formatDate(invoice.issue_date)}
                    </td>
                    <td class="px-5 py-3 text-right font-medium whitespace-nowrap tabular-nums">
                      {formatALL(invoice.total)}
                    </td>
                    <td class="px-5 py-3 text-right">
                      <StatusBadge status={displayStatus(invoice.status, invoice.due_date)} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            </div>
          </>
        )
      }
    </section>

    <!-- Side rail -->
    <div class="flex flex-col gap-6">
      <section class="bg-card ring-border rounded-xl p-5 ring-1">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold">Plani</h2>
          <span
            class:list={[
              'rounded-full px-2 py-0.5 text-[11px] font-bold',
              plan === 'free'
                ? 'bg-muted text-muted-foreground'
                : 'bg-brand/15 text-primary',
            ]}
          >
            {planSpec.badge}
          </span>
        </div>

        {
          unlimited ? (
            <p class="text-muted-foreground mt-3 text-sm">
              Fatura të palimituara. Faleminderit që na mbështet.
            </p>
          ) : (
            <>
              <div class="bg-muted mt-4 h-2 w-full overflow-hidden rounded-full">
                <div
                  class:list={[
                    'h-full rounded-full transition-all',
                    limitReached ? 'bg-warning' : 'bg-primary',
                  ]}
                  style={`width:${usedPct}%`}
                />
              </div>
              <p class="text-muted-foreground mt-2 text-sm">
                <strong class="text-foreground">{invoicesThisMonth}</strong> nga{' '}
                {invoiceLimit} fatura këtë muaj
              </p>
              <Button as="a" href="/app/abonimi" variant="outline" size="sm" class="mt-4 w-full">
                {plan === 'free'
                  ? `Kalo në ${PLANS.starter.name}`
                  : `Kalo në ${PLANS.pro.name}`}
              </Button>
            </>
          )
        }
      </section>

      <section class="bg-card ring-border rounded-xl p-5 ring-1">
        <h2 class="text-sm font-semibold">Përmbledhje</h2>
        <dl class="mt-4 flex flex-col gap-3 text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-muted-foreground">Fatura gjithsej</dt>
            <dd class="font-medium tabular-nums">{stats.total_invoices ?? 0}</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-muted-foreground">Draft</dt>
            <dd class="font-medium tabular-nums">{stats.draft_count ?? 0}</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-muted-foreground">Të vonuara</dt>
            <dd
              class:list={[
                'font-medium tabular-nums',
                Number(stats.overdue_count ?? 0) > 0 && 'text-destructive',
              ]}
            >
              {stats.overdue_count ?? 0}
            </dd>
          </div>
        </dl>
      </section>

      {
        (!profile?.nipt || !profile?.logo_url) && (
          <section class="border-primary/25 bg-accent/40 rounded-xl border p-5">
            <h2 class="text-sm font-semibold">Plotëso profilin</h2>
            <p class="text-muted-foreground mt-1 text-sm">
              {!profile?.nipt && !profile?.logo_url
                ? 'NIPT-i dhe logoja mungojnë në faturat e tua.'
                : !profile?.nipt
                  ? 'NIPT-i mungon në faturat e tua.'
                  : 'Logoja mungon në faturat e tua.'}
            </p>
            <Button as="a" href="/app/cilesimet" size="sm" variant="outline" class="mt-4 w-full">
              Shko te cilësimet
            </Button>
          </section>
        )
      }
    </div>
  </div>
</AppLayout>
