---
import AppLayout from '@/layouts/AppLayout.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { displayStatus } from '@/lib/types';
import { Button } from '@/components/ui/button';
import { Icon } from '@/components/ui/icon';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table';
import { formatALL, formatDate } from '@/lib/utils';
import type { InvoiceWithClient } from '@/lib/types';
import { PLANS, planOf, quotaReached, usageRatio } from '@/lib/plans';

export const prerender = false;

const { supabase, user, profile, invoicesThisMonth, plan, invoiceLimit } =
  Astro.locals;

/*
  Two round trips, both bounded:
    1. dashboard_stats() — every total summed in Postgres, one row back.
       This used to select *every invoice the user had ever created* and sum
       them in JS, so payload grew without limit.
    2. the five most recent invoices, selecting only the columns rendered
       (notably NOT the items JSONB, which is dead weight in a list).
*/
const [statsResult, recentResult] = await Promise.all([
  supabase.rpc('dashboard_stats'),
  supabase
    .from('invoices')
    .select('id, invoice_number, issue_date, due_date, total, status, clients(name)')
    .eq('owner_id', user!.id)
    .order('created_at', { ascending: false })
    .limit(5),
]);

const stats = (statsResult.data ?? {}) as Record<string, number>;
const recent = (recentResult.data ?? []) as unknown as InvoiceWithClient[];

/*
  The meter follows the tier in force, not a boolean: free caps at 5, Starter
  at 30, Pro not at all. `invoiceLimit` is null exactly when it is unlimited.
*/
const planSpec = planOf(plan);
const unlimited = invoiceLimit === null;
const usedPct = usageRatio(plan, invoicesThisMonth) * 100;
const limitReached = quotaReached(plan, invoicesThisMonth);

const monthTotal = Number(stats.month_total ?? 0);
const prevMonthTotal = Number(stats.prev_month_total ?? 0);
const delta =
  prevMonthTotal > 0
    ? Math.round(((monthTotal - prevMonthTotal) / prevMonthTotal) * 100)
    : null;

const kpis = [
  {
    label: 'Faturuar këtë muaj',
    value: formatALL(monthTotal),
    hint: 'Vlera e të gjitha faturave të lëshuara nga 1 i muajit deri sot.',
    delta,
  },
  {
    label: 'Të arkëtuara',
    value: formatALL(Number(stats.paid_total ?? 0)),
    hint: 'Totali i faturave që i ke shënuar si të paguara.',
    tone: 'text-success',
  },
  {
    label: "Për t'u arkëtuar",
    value: formatALL(Number(stats.outstanding_total ?? 0)),
    hint: "Faturat e dërguara që ende nuk janë paguar.",
    tone: 'text-warning',
    note:
      Number(stats.overdue_count ?? 0) > 0
        ? `${stats.overdue_count} të vonuara`
        : undefined,
  },
  {
    label: 'Klientë',
    value: String(stats.client_count ?? 0),
    hint: 'Klientët e ruajtur në regjistrin tënd.',
  },
];

const today = new Intl.DateTimeFormat('sq-AL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date());

// Use the whole business name — splitting on whitespace turns
// "Bar Kafe Vlora" into "Bar".
const businessName = profile?.business_name?.trim() ?? '';
---

<AppLayout title="Paneli — Fatura.co" active="dashboard">
  <!-- Page header -->
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-[-0.03em] sm:text-3xl">
        Mirë se erdhe{businessName ? `, ${businessName}` : ''}
      </h1>
      <p class="text-muted-foreground mt-1 text-sm">Përditësuar më {today}</p>
    </div>

    <div class="flex items-center gap-2">
      <Button as="a" href="/app/klientet" variant="outline" class="rounded-full px-4">
        <Icon name="users" /> Klientët
      </Button>
      {/* Compose belongs to the floating button below `lg`; two of them in
          one view is the same action asked twice. */}
      <Button
        as="a"
        href="/app/faturat/e-re"
        class="hidden rounded-full px-4 lg:inline-flex"
      >
        <Icon name="plus" /> Faturë e re
      </Button>
    </div>
  </div>

  {
    limitReached && (
      <div class="border-warning/40 bg-warning/10 mb-6 flex flex-wrap items-center justify-between gap-4 rounded-2xl border px-5 py-4">
        <div class="flex items-start gap-3">
          <Icon name="triangle-alert" class="text-warning mt-0.5 shrink-0" />
          <div>
            <p class="text-sm font-semibold">Ke mbaruar faturat falas për këtë muaj</p>
            <p class="text-muted-foreground mt-0.5 text-sm">
              Kalo në planin Pro për fatura të palimituara, ose prit muajin tjetër.
            </p>
          </div>
        </div>
        <Button as="a" href="/app/abonimi" size="sm" class="rounded-full px-4">
          Shiko planin Pro
        </Button>
      </div>
    )
  }

  {/*
    One card holding every headline number, split by hairlines, rather than
    four separate tiles. Four tiles gave each number its own box and so its own
    visual weight; these four belong to one statement about the month, and
    reading them as a row is the point. The rules collapse at the breakpoints
    where the columns stack.
  */}
  <section class="bg-card shadow-card rounded-2xl p-6">
    <div class="flex items-center gap-2.5">
      <span class="bg-accent text-primary flex size-8 items-center justify-center rounded-full">
        <Icon name="chart-no-axes-column" class="size-4" />
      </span>
      <h2 class="font-semibold tracking-tight">Përmbledhje financiare</h2>
    </div>

    <dl class="mt-6 grid gap-6 sm:grid-cols-2 sm:gap-y-8 lg:grid-cols-4 lg:gap-0">
      {
        kpis.map((kpi, index) => (
          <div
            class:list={[
              'lg:px-6 lg:first:pl-0 lg:last:pr-0',
              index > 0 && 'lg:border-l',
            ]}
          >
            <dt class="text-muted-foreground flex items-center gap-1.5 text-sm">
              {kpi.label}
              <span title={kpi.hint} class="cursor-help">
                <Icon name="info" class="text-muted-foreground/50 size-3.5" />
                <span class="sr-only">{kpi.hint}</span>
              </span>
            </dt>

            <dd class="mt-2 flex flex-wrap items-baseline gap-x-2 gap-y-1">
              <span
                class={`text-2xl font-bold tracking-[-0.03em] tabular-nums ${kpi.tone ?? ''}`}
              >
                {kpi.value}
              </span>

              {kpi.delta !== null && kpi.delta !== undefined && (
                <span
                  class:list={[
                    'inline-flex items-center gap-0.5 rounded-full px-1.5 py-0.5 text-xs font-semibold',
                    kpi.delta >= 0
                      ? 'bg-success/10 text-success'
                      : 'bg-destructive/10 text-destructive',
                  ]}
                >
                  {kpi.delta >= 0 ? '↑' : '↓'} {Math.abs(kpi.delta)}%
                </span>
              )}

              {kpi.note && (
                <span class="text-muted-foreground text-xs">{kpi.note}</span>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <div class="mt-5 grid gap-5 lg:grid-cols-[1fr_340px]">
    <!-- Recent invoices -->
    <section class="bg-card shadow-card overflow-hidden rounded-2xl">
      <div class="flex items-center justify-between gap-3 px-6 py-5">
        <div class="flex items-center gap-2.5">
          <span class="bg-accent text-primary flex size-8 items-center justify-center rounded-full">
            <Icon name="file-text" class="size-4" />
          </span>
          <h2 class="font-semibold tracking-tight">Faturat e fundit</h2>
        </div>
        <a
          href="/app/faturat"
          class="text-primary text-sm font-medium hover:underline"
        >
          Shiko të gjitha
        </a>
      </div>

      {
        recent.length === 0 ? (
          <div class="px-6 pt-4 pb-14 text-center">
            <div class="bg-muted mx-auto flex size-12 items-center justify-center rounded-full">
              <Icon name="file-text" class="text-muted-foreground size-5" />
            </div>
            <h3 class="mt-4 text-sm font-semibold">Ende asnjë faturë</h3>
            <p class="text-muted-foreground mx-auto mt-1 max-w-xs text-sm">
              Krijo faturën e parë — të merr më pak se 2 minuta.
            </p>
            <Button as="a" href="/app/faturat/e-re" class="mt-5 rounded-full px-5">
              Krijo faturën e parë
            </Button>
          </div>
        ) : (
          <>
            {/*
              A four-column table cannot fit a 360px screen: the invoice number
              broke across three lines and the status column fell off the right
              edge. Below `sm` each invoice is one scannable row instead —
              identity on the left, money on the right — and the table returns
              once there is width for it.
            */}
            <ul class="divide-y border-t sm:hidden">
              {recent.map((invoice) => (
                <a
                  href={`/app/faturat/${invoice.id}`}
                  class="hover:bg-muted/40 flex items-center justify-between gap-3 px-4 py-3 transition-colors"
                >
                  <span class="min-w-0 flex-1">
                    <span class="text-primary block truncate font-medium">
                      {invoice.invoice_number}
                    </span>
                    <span class="text-muted-foreground block truncate text-xs">
                      {invoice.clients?.name ?? '—'} · {formatDate(invoice.issue_date)}
                    </span>
                  </span>
                  <span class="flex shrink-0 flex-col items-end gap-1">
                    <span class="font-medium whitespace-nowrap tabular-nums">
                      {formatALL(invoice.total)}
                    </span>
                    <StatusBadge status={displayStatus(invoice.status, invoice.due_date)} />
                  </span>
                </a>
              ))}
            </ul>

            <Table containerClass="hidden border-t sm:block">
              {/* No `bg-muted/40` here: this card already sits on a tinted
                  surface, so the default header fill would read as a band. */}
              <TableHeader class="bg-transparent">
                <TableRow class="hover:bg-transparent">
                  <TableHead class="py-2.5 pl-6">Numri</TableHead>
                  <TableHead class="py-2.5">Klienti</TableHead>
                  <TableHead class="hidden py-2.5 sm:table-cell">Data</TableHead>
                  <TableHead class="py-2.5 text-right">Totali</TableHead>
                  <TableHead class="py-2.5 pr-6 text-right">Statusi</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {recent.map((invoice) => (
                  <TableRow>
                    <TableCell class="py-3 pl-6">
                      <a
                        href={`/app/faturat/${invoice.id}`}
                        class="text-primary font-medium whitespace-nowrap hover:underline"
                      >
                        {invoice.invoice_number}
                      </a>
                    </TableCell>
                    <TableCell class="max-w-[16rem] truncate py-3">
                      {invoice.clients?.name ?? '—'}
                    </TableCell>
                    <TableCell class="text-muted-foreground hidden py-3 sm:table-cell">
                      {formatDate(invoice.issue_date)}
                    </TableCell>
                    <TableCell class="py-3 text-right font-medium whitespace-nowrap tabular-nums">
                      {formatALL(invoice.total)}
                    </TableCell>
                    <TableCell class="py-3 pr-6 text-right">
                      <StatusBadge status={displayStatus(invoice.status, invoice.due_date)} />
                    </TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          </>
        )
      }
    </section>

    <!-- Side rail -->
    <div class="flex flex-col gap-5">
      <section class="bg-card shadow-card rounded-2xl p-6">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2.5">
            <span class="bg-accent text-primary flex size-8 items-center justify-center rounded-full">
              <Icon name="gauge" class="size-4" />
            </span>
            <h2 class="font-semibold tracking-tight">Plani</h2>
          </div>
          <span
            class:list={[
              'rounded-full px-2.5 py-0.5 text-[11px] font-bold',
              plan === 'free'
                ? 'bg-muted text-muted-foreground'
                : 'bg-accent text-primary',
            ]}
          >
            {planSpec.badge}
          </span>
        </div>

        {
          unlimited ? (
            <p class="text-muted-foreground mt-4 text-sm">
              Fatura të palimituara. Faleminderit që na mbështet.
            </p>
          ) : (
            <>
              {/*
                The meter is the design's: a rounded track with a knob riding
                the leading edge, and the count stated above it rather than
                below, so the number and the bar read as one unit.
              */}
              <p class="mt-5 flex items-baseline justify-between text-sm">
                <span class="text-muted-foreground">Fatura këtë muaj</span>
                <span class="font-semibold tabular-nums">
                  {invoicesThisMonth}/{invoiceLimit}
                </span>
              </p>

              <div
                class="meter mt-2.5"
                role="progressbar"
                aria-valuenow={invoicesThisMonth}
                aria-valuemin={0}
                aria-valuemax={invoiceLimit ?? undefined}
                aria-label="Fatura të përdorura këtë muaj"
              >
                <span
                  class:list={[
                    'meter-fill',
                    limitReached ? 'bg-warning' : 'bg-primary',
                  ]}
                  style={`width:${usedPct}%`}
                />
              </div>

              <Button
                as="a"
                href="/app/abonimi"
                variant="outline"
                size="sm"
                class="mt-6 w-full rounded-full"
              >
                {plan === 'free'
                  ? `Kalo në ${PLANS.starter.name}`
                  : `Kalo në ${PLANS.pro.name}`}
              </Button>
            </>
          )
        }
      </section>

      <section class="bg-card shadow-card rounded-2xl p-6">
        <div class="flex items-center gap-2.5">
          <span class="bg-accent text-primary flex size-8 items-center justify-center rounded-full">
            <Icon name="list" class="size-4" />
          </span>
          <h2 class="font-semibold tracking-tight">Përmbledhje</h2>
        </div>
        <dl class="mt-5 flex flex-col gap-3.5 text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-muted-foreground">Fatura gjithsej</dt>
            <dd class="font-semibold tabular-nums">{stats.total_invoices ?? 0}</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-muted-foreground">Draft</dt>
            <dd class="font-semibold tabular-nums">{stats.draft_count ?? 0}</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-muted-foreground">Të vonuara</dt>
            <dd
              class:list={[
                'font-semibold tabular-nums',
                Number(stats.overdue_count ?? 0) > 0 && 'text-destructive',
              ]}
            >
              {stats.overdue_count ?? 0}
            </dd>
          </div>
        </dl>
      </section>

      {
        (!profile?.nipt || !profile?.logo_url) && (
          <section class="border-primary/25 bg-accent/40 rounded-2xl border p-6">
            <h2 class="text-sm font-semibold">Plotëso profilin</h2>
            <p class="text-muted-foreground mt-1 text-sm">
              {!profile?.nipt && !profile?.logo_url
                ? 'NIPT-i dhe logoja mungojnë në faturat e tua.'
                : !profile?.nipt
                  ? 'NIPT-i mungon në faturat e tua.'
                  : 'Logoja mungon në faturat e tua.'}
            </p>
            <Button
              as="a"
              href="/app/cilesimet"
              size="sm"
              variant="outline"
              class="mt-4 w-full rounded-full"
            >
              Shko te cilësimet
            </Button>
          </section>
        )
      }
    </div>
  </div>
</AppLayout>
