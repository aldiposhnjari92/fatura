---
import AuthLayout from '@/layouts/AuthLayout.astro';
import AuthForm from '@/components/react/AuthForm';
import { PLAN_OPTIONS, PRO_MONTHLY_ALL } from '@/lib/payments';
import { formatALL } from '@/lib/utils';

export const prerender = false;

/*
  The pricing cards link here with ?plan=pro&muaj=N. Without carrying that
  through, every signup silently landed on the free plan no matter which card
  was clicked — the choice was simply dropped.

  Signing up does NOT grant Pro; nothing has been paid yet. The intent is
  carried to the checkout instead, with the chosen term preselected.
*/
const params = Astro.url.searchParams;
const wantsPro = params.get('plan') === 'pro';
const requested = Number.parseInt(params.get('muaj') ?? '', 10);
const months = PLAN_OPTIONS.some((o) => o.months === requested) ? requested : 1;
const plan = PLAN_OPTIONS.find((o) => o.months === months) ?? PLAN_OPTIONS[0];

const next = wantsPro ? `/app/abonimi?muaj=${months}` : '/app/cilesimet?welcome=1';
---

<AuthLayout
  title="Krijo llogari falas — Fatura.co"
  description="Krijo llogarinë falas dhe bëj faturën e parë me NIPT dhe logo në 2 minuta."
  heading={wantsPro ? 'Krijo llogarinë për Pro' : 'Krijo llogarinë falas'}
  subheading={
    wantsPro
      ? `Pas regjistrimit vazhdon me pagesën për ${plan.label}.`
      : 'Pa kartë krediti. Fatura e parë brenda 5 minutash.'
  }
>
  {
    wantsPro && (
      <div class="border-primary/25 bg-accent/40 mb-6 rounded-xl border px-4 py-3">
        <div class="flex items-center justify-between gap-3">
          <div>
            <p class="text-sm font-semibold">Plani Pro · {plan.label}</p>
            <p class="text-muted-foreground mt-0.5 text-xs">
              {formatALL(PRO_MONTHLY_ALL)}/muaj · fatura të palimituara
            </p>
          </div>
          <p class="shrink-0 text-lg font-bold tabular-nums">{formatALL(plan.total)}</p>
        </div>
      </div>
    )
  }

  <AuthForm
    mode="register"
    next={next}
    submitLabel={wantsPro ? 'Vazhdo me pagesën' : undefined}
    client:load
  />

  <p class="text-muted-foreground mt-6 text-center text-xs leading-relaxed">
    Duke krijuar llogari pranon <a href="/kushtet" class="underline hover:text-foreground"
      >Kushtet e përdorimit</a
    > dhe <a href="/privatesia" class="underline hover:text-foreground"
      >Politikën e privatësisë</a
    >.
  </p>
</AuthLayout>
