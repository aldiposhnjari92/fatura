---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import HeroSection from '@/components/sections/HeroSection.astro';
import TrustBar from '@/components/sections/TrustBar.astro';
import ShowcaseSection from '@/components/sections/ShowcaseSection.astro';
import FeaturesSection from '@/components/sections/FeaturesSection.astro';
import Pricing2 from '@/components/blocks/pricing-2.astro';
import Faqs1 from '@/components/blocks/faqs-1.astro';
import Cta1 from '@/components/blocks/cta-1.astro';
import ProblemSection from '@/components/sections/ProblemSection.astro';
import StepsSection from '@/components/sections/StepsSection.astro';
import WaitlistSection from '@/components/sections/WaitlistSection.astro';

// Fully static: no session lookup, no JS shipped, cached at the edge.
export const prerender = true;

const plans = [
  {
    name: 'Falas',
    description: 'Për të filluar sot.',
    price: 0,
    currency: 'ALL',
    unit: 'muaj',
    features: [
      '5 fatura në muaj',
      'Klientë të palimituar',
      'PDF me logon tënde',
      'TVSH dhe zbritje',
    ],
    note: 'Pa kartë krediti',
    button: { label: 'Fillo falas', href: '/regjistrohu', variant: 'outline' as const },
    authedButton: {
      label: 'Shko te paneli',
      href: '/app',
      variant: 'outline' as const,
    },
  },
  {
    name: 'Starter',
    description: 'Për biznese që faturojnë çdo javë.',
    price: 1000,
    currency: 'ALL',
    unit: 'muaj',
    features: [
      '30 fatura në muaj',
      'Gjithçka nga plani falas',
      'Klientë të palimituar',
      'Anulo kur të duash',
    ],
    note: 'Anulo kur të duash',
    button: {
      label: 'Fillo me Starter',
      href: '/regjistrohu?plan=starter&muaj=1',
      variant: 'outline' as const,
    },
    authedButton: {
      label: 'Kalo në Starter',
      href: '/app/abonimi?plan=starter&muaj=1',
      variant: 'outline' as const,
    },
  },
  {
    name: 'Pro',
    description: 'Për biznese që faturojnë çdo ditë.',
    price: 2000,
    currency: 'ALL',
    unit: 'muaj',
    features: [
      'Fatura të palimituara',
      'Gjithçka nga plani Starter',
      'Mbështetje me përparësi në WhatsApp',
      'Veçoritë e reja të parët',
    ],
    featured: true,
    badge: 'Më i zgjedhuri',
    note: 'Anulo kur të duash',
    button: { label: 'Fillo me Pro', href: '/regjistrohu?plan=pro&muaj=1' },
    authedButton: { label: 'Kalo në Pro', href: '/app/abonimi?plan=pro&muaj=1' },
  },
];

const faqs = [
  {
    id: 'falas',
    question: 'A është vërtet falas?',
    answer:
      'Po. Plani falas të lejon 5 fatura në muaj, klientë të palimituar dhe PDF me logon tënde. Nëse të duhen më shumë, Starter (1000 Lekë/muaj) të jep 30 fatura në muaj dhe Pro (2000 Lekë/muaj) i heq fare limitet.',
  },
  {
    id: 'nipt',
    question: 'A i plotëson faturat kërkesat për NIPT?',
    answer:
      'Fatura përmban NIPT-in tënd, NIPT-in e klientit, datën, numrin unik të faturës, artikujt, TVSH-në dhe totalin — të dhënat standarde të një fature tregtare. Për fiskalizim në kohë reale me sistemin e DPT-së, Fatura.co ende nuk lidhet automatikisht; është mjet për faturim dhe dokumentim.',
  },
  {
    id: 'kompjuter',
    question: 'A më duhet kompjuter?',
    answer:
      'Jo. Fatura.co punon plotësisht në shfletuesin e telefonit. PDF-ja gjenerohet direkt në pajisjen tënde.',
  },
  {
    id: 'te-dhenat',
    question: 'Ku ruhen të dhënat e mia?',
    answer:
      'Të dhënat ruhen të enkriptuara në Supabase (serverë në Bashkimin Evropian). Vetëm ti ke akses te faturat dhe klientët e tu.',
  },
  {
    id: 'numri',
    question: 'A mund ta ndryshoj numrin e faturës?',
    answer:
      'Po. Ne propozojmë formatin FAT-2025-001 dhe e rrisim vetë numrin, por ti mund ta shkruash si të duash.',
  },
  {
    id: 'pagesa',
    question: 'Si paguhet plani me pagesë?',
    answer:
      'Me transfertë bankare. Zgjedh planin (Starter ose Pro) dhe 1, 6 ose 12 muaj, merr një referencë unike nga paneli, e vendos në përshkrimin e transfertës dhe plani aktivizohet zakonisht brenda 24 orëve pune. Pagesat me kartë dhe PayPal shtohen sapo të lidhet llogaria tregtare.',
  },
  {
    id: 'anulimi',
    question: 'Çfarë ndodh nëse e anuloj abonimin?',
    answer:
      'Vazhdon ta përdorësh planin me të gjitha veçoritë deri në fund të periudhës që ke paguar — nuk humbet asnjë ditë. Pas asaj date llogaria kalon vetë në planin falas dhe faturat ekzistuese mbeten të paprekura; asgjë nuk fshihet.',
  },
  {
    id: 'freelancer',
    question: 'A punon për profesionistë të lirë (freelancers)?',
    answer:
      'Po, dhe është ndërtuar pikërisht për ta. Fatura me NIPT, TVSH dhe të dhënat e plota të biznesit janë të gatshme që në ditën e parë.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

const appJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Fatura.co',
  url: 'https://fatura.co',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description:
    'Krijo fatura profesionale me NIPT dhe logo në 2 minuta, nga telefoni. Për bizneset e vogla dhe të vetëpunësuarit në Shqipëri.',
  inLanguage: 'sq',
  offers: plans.map((plan) => ({
    '@type': 'Offer',
    name: plan.name,
    price: String(plan.price),
    priceCurrency: 'ALL',
    description: plan.features.join(', '),
  })),
};
---

<MarketingLayout
  title="Fatura.co — Fatura profesionale me NIPT dhe logo, në 2 minuta"
  description="Bizneset e vogla në Shqipëri humbin 2 orë në javë duke bërë fatura në Word. Fatura.co i bën në 2 minuta nga telefoni: PDF me NIPT, logo dhe TVSH. Falas."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(appJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <HeroSection />

  <TrustBar />

  <ProblemSection />

  <ShowcaseSection />

  <FeaturesSection class="scroll-mt-16" />

  <StepsSection />

  <Pricing2
    title="Çmime të thjeshta"
    description="Fillo falas. Paguaj vetëm kur biznesi rritet."
    plans={plans}
  />

  <WaitlistSection />

  <div id="faq" class="scroll-mt-16">
  <Faqs1
    class="bg-muted/40"
    title="Pyetje të shpeshta"
    description="Çfarë pyesin më shpesh bizneset që sapo fillojnë."
    faqs={faqs}
  />
  </div>

  <Cta1
    class="dark bg-ink"
    title="Fatura jote e ardhshme, në 2 minuta"
    description="Krijo llogarinë falas dhe shkarko faturën e parë sot. Pa kartë krediti, pa kontratë."
    buttons={[
      { label: 'Fillo falas', href: '/regjistrohu', 'data-auth-show': 'anon' },
      {
        label: 'Shko te paneli',
        href: '/app',
        variant: 'default',
        'data-auth-show': 'user',
      },
    ]}
  />
</MarketingLayout>
