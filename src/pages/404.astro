---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import { Section, SectionContainer } from '@/components/ui/section';
import { Button } from '@/components/ui/button';

export const prerender = true;
---

<MarketingLayout
  title="Faqja nuk u gjet — Fatura.co"
  description="Faqja që kërkove nuk ekziston."
  noindex={true}
>
  <Section class="min-h-[70vh] justify-center">
    <SectionContainer class="items-center gap-6 text-center">
      <p class="text-primary text-6xl font-bold tracking-tight">404</p>
      <div class="flex max-w-lg flex-col gap-3">
        <h1 class="text-foreground text-2xl font-semibold tracking-tight">
          Kjo faqe nuk ekziston
        </h1>
        <p class="text-muted-foreground">
          Ndoshta lidhja është e vjetër, ose adresa u shkrua gabim.
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-3">
        <Button as="a" href="/" size="lg">Kthehu në ballinë</Button>
        <Button as="a" href="/app" size="lg" variant="outline">Shko te paneli</Button>
      </div>
    </SectionContainer>
  </Section>
</MarketingLayout>
