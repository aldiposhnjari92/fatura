---
import AdminLayout from '@/layouts/AdminLayout.astro';
import TableSort from '@/components/TableSort.astro';
import { formatALL, formatDate } from '@/lib/utils';
import { useTranslations } from '@/lib/i18n';

export const prerender = false;

/*
  The manager's console page — and the only one they can reach.

  Everything shown here comes from manager_invoices(), which returns invoice
  *metadata* and nothing else: no line items, no notes, no client contact
  details. Those belong to the customer, and the rule that staff never read
  them is enforced in the database, not by leaving fields out of this template.
*/

const { supabase, profile } = Astro.locals;
const t = useTranslations();

const params = Astro.url.searchParams;
const VALID = ['draft', 'unpaid', 'paid', 'overdue'];
const rawStatus = params.get('statusi');
const status = VALID.includes(rawStatus ?? '') ? rawStatus : null;

const [listResult, statsResult] = await Promise.all([
  supabase.rpc('manager_invoices', { p_limit: 100, p_offset: 0, p_status: status }),
  supabase.rpc('manager_stats'),
]);

const list = (listResult.data ?? { rows: [], total: 0 }) as {
  rows: {
    id: string;
    invoice_number: string;
    issue_date: string;
    due_date: string | null;
    total: number;
    status: string;
    paid_at: string | null;
    overdue: boolean;
    business_name: string | null;
    city: string | null;
  }[];
  total: number;
};
const stats = (statsResult.data ?? {}) as Record<string, number>;

const error = listResult.error?.message ?? statsResult.error?.message ?? null;

const kpis = [
  { label: t('adm.totalInvoices'), value: stats.total_invoices ?? 0 },
  { label: t('adm.last30d'), value: stats.invoices_30d ?? 0 },
  { label: t('status.paid'), value: stats.paid_count ?? 0 },
  { label: t('status.overdue'), value: stats.overdue_count ?? 0 },
];

const filters = [
  { label: t('common.all'), value: null },
  { label: t('status.unpaid'), value: 'unpaid' },
  { label: t('status.paid'), value: 'paid' },
  { label: t('status.overdue'), value: 'overdue' },
];

const BADGE: Record<string, string> = {
  draft: 'bg-slate-200 text-slate-700 dark:bg-white/10 dark:text-slate-200',
  unpaid: 'bg-amber-100 text-amber-900 dark:bg-amber-400/15 dark:text-amber-200',
  paid: 'bg-teal-100 text-teal-900 dark:bg-brand/20 dark:text-brand',
  overdue: 'bg-red-100 text-red-900 dark:bg-red-400/15 dark:text-red-200',
};
const LABEL: Record<string, string> = {
  draft: t('status.draft'),
  unpaid: t('status.unpaid'),
  paid: t('status.paid'),
  overdue: t('status.overdue'),
};
---

<AdminLayout
  title={`${t('adm.invoiceActivity')} — Fatura.co`}
  heading={t('adm.invoiceActivity')}
  subheading={profile?.is_admin ? undefined : t('adm.manager')}
  active="invoices"
>
  {
    error && (
      <p class="border-destructive/30 bg-destructive/10 text-destructive mb-6 rounded-lg border px-4 py-3 text-sm">
        {error}
      </p>
    )
  }

  <div class="mb-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      kpis.map((kpi) => (
        <div class="bg-card ring-border rounded-xl p-5 ring-1">
          <p class="text-muted-foreground text-xs font-medium tracking-wide uppercase">
            {kpi.label}
          </p>
          <p class="mt-2 text-2xl font-semibold tabular-nums">{kpi.value}</p>
        </div>
      ))
    }
  </div>

  <div class="mb-4 flex flex-wrap gap-2">
    {
      filters.map((filter) => (
        <a
          href={filter.value ? `/admin/faturat?statusi=${filter.value}` : '/admin/faturat'}
          class:list={[
            'rounded-lg px-3 py-1.5 text-sm font-medium transition-colors',
            status === filter.value
              ? 'bg-primary text-primary-foreground'
              : 'text-muted-foreground hover:bg-muted hover:text-foreground',
          ]}
        >
          {filter.label}
        </a>
      ))
    }
  </div>

  <div class="bg-card ring-border overflow-hidden rounded-xl ring-1">
    {
      list.rows.length === 0 ? (
        <p class="text-muted-foreground px-5 py-12 text-center text-sm">
          {t('adm.noResults')}
        </p>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full min-w-[640px] text-sm" data-sortable>
            <thead>
              <tr class="bg-muted/40 border-b">
                <th class="text-muted-foreground px-5 py-3 text-left text-xs font-medium" data-sort-key="numri">
                  {t('inv.number')}
                </th>
                <th class="text-muted-foreground px-5 py-3 text-left text-xs font-medium" data-sort-key="biznesi">
                  {t('adm.business')}
                </th>
                <th class="text-muted-foreground hidden px-5 py-3 text-left text-xs font-medium md:table-cell" data-sort-key="data" data-sort-type="date">
                  {t('inv.issueDate')}
                </th>
                <th class="text-muted-foreground px-5 py-3 text-right text-xs font-medium" data-sort-key="totali" data-sort-type="number">
                  {t('inv.total')}
                </th>
                <th class="text-muted-foreground px-5 py-3 text-right text-xs font-medium" data-sort-key="statusi">
                  {t('inv.status')}
                </th>
              </tr>
            </thead>
            <tbody class="divide-y">
              {list.rows.map((row) => {
                const shown = row.overdue ? 'overdue' : row.status;
                return (
                  <tr class="hover:bg-muted/40 transition-colors">
                    <td class="px-5 py-3 font-mono text-xs">{row.invoice_number}</td>
                    <td class="max-w-[16rem] truncate px-5 py-3">
                      {row.business_name ?? (
                        <span class="text-muted-foreground italic">{t('adm.noName')}</span>
                      )}
                      {row.city && (
                        <span class="text-muted-foreground text-xs"> · {row.city}</span>
                      )}
                    </td>
                    <td class="text-muted-foreground hidden px-5 py-3 md:table-cell" data-sort-value={row.issue_date}>
                      {formatDate(row.issue_date)}
                    </td>
                    <td class="px-5 py-3 text-right font-medium tabular-nums" data-sort-value={String(row.total)}>
                      {formatALL(row.total)}
                    </td>
                    <td class="px-5 py-3 text-right">
                      <span
                        class={`inline-block rounded-full px-2 py-0.5 text-[10px] font-semibold ${BADGE[shown]}`}
                      >
                        {LABEL[shown]}
                      </span>
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      )
    }
  </div>

  <p class="text-muted-foreground mt-4 text-xs leading-relaxed">
    Kjo faqe tregon vetëm të dhënat kryesore të faturave. Artikujt, shënimet dhe
    kontaktet e klientëve nuk lexohen nga stafi — RLS nuk hiqet për asnjë rol.
  </p>
  <TableSort />
</AdminLayout>
