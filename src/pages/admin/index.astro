---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { Icon } from '@/components/ui/icon';
import PaymentQueue from '@/components/react/PaymentQueue';
import { formatALL, formatDate, groupThousands } from '@/lib/utils';

export const prerender = false;

/*
  Reachable only by an admin: the middleware redirects everyone else, and each
  RPC below independently re-checks is_admin() in the database. RLS is NOT
  relaxed for admins — these functions return aggregates, never other
  businesses' rows, so a mistake here leaks a count rather than a customer list.
*/
const { supabase } = Astro.locals;

const [statsResult, seriesResult, businessesResult, pendingResult] = await Promise.all([
  supabase.rpc('admin_stats'),
  supabase.rpc('admin_signup_series'),
  supabase.rpc('admin_recent_businesses', { p_limit: 15 }),
  supabase.rpc('admin_pending_payments'),
]);

const s = (statsResult.data ?? {}) as Record<string, number>;
const series = (seriesResult.data ?? []) as {
  day: string;
  signups: number;
  invoices: number;
}[];
const businesses = (businessesResult.data ?? []) as {
  business_name: string | null;
  city: string | null;
  is_pro: boolean;
  created_at: string;
  invoice_count: number;
}[];

const rpcError = statsResult.error?.message ?? null;
const pendingPayments = (pendingResult.data ?? []) as any[];

const num = (v: unknown) => Number(v ?? 0);
const pct = (a: number, b: number) => (b > 0 ? Math.round((a / b) * 100) : 0);

const totalUsers = num(s.total_users);
const proUsers = num(s.pro_users);
const active30 = num(s.active_users_30d);

const headline = [
  {
    label: 'Përdorues gjithsej',
    value: groupThousands(totalUsers),
    icon: 'users',
    hint: `+${num(s.new_users_7d)} këtë javë`,
  },
  {
    label: 'Abonentë Pro',
    value: groupThousands(proUsers),
    icon: 'sparkles',
    tone: 'text-primary',
    hint: `${pct(proUsers, totalUsers)}% konvertim`,
  },
  {
    label: 'MRR',
    value: formatALL(num(s.mrr_all)),
    icon: 'trending-up',
    tone: 'text-success',
    hint: '990 Lekë / abonent',
  },
  {
    label: 'Aktivë (30 ditë)',
    value: groupThousands(active30),
    icon: 'activity',
    hint: `${pct(active30, totalUsers)}% e bazës`,
  },
];

const revenue = [
  { label: 'Arkëtuar gjithsej', value: formatALL(num(s.revenue_confirmed)) },
  { label: 'Arkëtuar (30 ditë)', value: formatALL(num(s.revenue_30d)) },
  { label: 'Pagesa në pritje', value: groupThousands(num(s.payments_pending)) },
];

const secondary = [
  { label: 'Fatura gjithsej', value: groupThousands(num(s.total_invoices)) },
  { label: 'Fatura (30 ditë)', value: groupThousands(num(s.invoices_30d)) },
  { label: 'Vlera e faturuar', value: formatALL(num(s.invoiced_total)) },
  { label: 'Prej saj e paguar', value: formatALL(num(s.invoiced_paid)) },
  { label: 'Klientë të ruajtur', value: groupThousands(num(s.total_clients)) },
  { label: 'Kanë plotësuar profilin', value: groupThousands(num(s.onboarded_users)) },
  { label: 'Kanë ngarkuar logo', value: groupThousands(num(s.users_with_logo)) },
  { label: 'Lista e pritjes', value: groupThousands(num(s.waitlist_total)) },
];

// Chart geometry — a plain inline SVG, no charting library.
const maxSignups = Math.max(1, ...series.map((d) => num(d.signups)));
const maxInvoices = Math.max(1, ...series.map((d) => num(d.invoices)));
const chartMax = Math.max(maxSignups, maxInvoices);
---

<AdminLayout
  title="Përmbledhje — Admin Fatura.co"
  heading="Përmbledhje e platformës"
  subheading="Gjendja e sistemit në një vështrim."
  active="overview"
  pendingCount={pendingPayments.length}
>
  {
    rpcError && (
      <p class="border-destructive/30 bg-destructive/10 text-destructive mb-6 rounded-lg border px-4 py-3 text-sm">
        Nuk u lexuan statistikat: {rpcError}
      </p>
    )
  }

  <!-- Headline metrics -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      headline.map((kpi) => (
        <div class="bg-card ring-border rounded-xl p-5 ring-1">
          <div class="flex items-center justify-between">
            <p class="text-muted-foreground text-xs font-medium tracking-wide uppercase">
              {kpi.label}
            </p>
            <Icon name={kpi.icon} class="text-muted-foreground/60 size-4" />
          </div>
          <p class={`mt-3 text-2xl font-semibold tracking-tight tabular-nums ${kpi.tone ?? ''}`}>
            {kpi.value}
          </p>
          <p class="text-muted-foreground mt-1.5 text-xs">{kpi.hint}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_320px]">
    <div class="flex flex-col gap-6">
      <!-- 30-day activity -->
      <section class="bg-card ring-border rounded-xl p-5 ring-1">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-sm font-semibold">Aktiviteti — 30 ditët e fundit</h2>
          <div class="flex items-center gap-4 text-xs">
            <span class="flex items-center gap-1.5">
              <span class="bg-primary size-2 rounded-full"></span> Regjistrime
            </span>
            <span class="flex items-center gap-1.5">
              <span class="bg-brand/40 size-2 rounded-full"></span> Fatura
            </span>
          </div>
        </div>

        {
          series.length === 0 ? (
            <p class="text-muted-foreground py-10 text-center text-sm">
              Ende pa të dhëna.
            </p>
          ) : (
            <div class="mt-5 flex h-40 items-end gap-[3px]">
              {series.map((d) => {
                const sh = (num(d.signups) / chartMax) * 100;
                const ih = (num(d.invoices) / chartMax) * 100;
                return (
                  <div
                    class="group relative flex h-full flex-1 items-end justify-center gap-[2px]"
                    title={`${formatDate(d.day)} · ${num(d.signups)} regjistrime · ${num(d.invoices)} fatura`}
                  >
                    <div
                      class="bg-primary w-1/2 rounded-t-sm transition-opacity group-hover:opacity-80"
                      style={`height:${Math.max(sh, num(d.signups) > 0 ? 4 : 1)}%`}
                    />
                    <div
                      class="bg-brand/40 w-1/2 rounded-t-sm transition-opacity group-hover:opacity-80"
                      style={`height:${Math.max(ih, num(d.invoices) > 0 ? 4 : 1)}%`}
                    />
                  </div>
                );
              })}
            </div>
          )
        }

        <div class="text-muted-foreground mt-2 flex justify-between text-xs">
          <span>{series.length ? formatDate(series[0].day) : ''}</span>
          <span>{series.length ? formatDate(series[series.length - 1].day) : ''}</span>
        </div>
      </section>

      <!-- Payment approvals -->
      <section class="bg-card ring-border overflow-hidden rounded-xl ring-1">
        <div class="flex items-center justify-between border-b px-5 py-4">
          <h2 class="text-sm font-semibold">Pagesa në pritje</h2>
          {
            pendingPayments.length > 0 && (
              <span class="bg-warning/15 text-warning rounded-full px-2 py-0.5 text-[11px] font-bold">
                {pendingPayments.length}
              </span>
            )
          }
        </div>
        <PaymentQueue initial={pendingPayments} client:load />
      </section>

      <!-- Recent businesses -->
      <section class="bg-card ring-border overflow-hidden rounded-xl ring-1">
        <div class="flex items-center justify-between border-b px-5 py-4">
          <h2 class="text-sm font-semibold">Bizneset e fundit</h2>
          <span class="text-muted-foreground text-xs">
            emri dhe qyteti — pa NIPT apo kontakte
          </span>
        </div>

        {
          businesses.length === 0 ? (
            <p class="text-muted-foreground px-5 py-12 text-center text-sm">
              Ende asnjë biznes i regjistruar.
            </p>
          ) : (
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead>
                  <tr class="bg-muted/40 border-b">
                    <th class="text-muted-foreground px-5 py-3 text-left text-xs font-medium">
                      Biznesi
                    </th>
                    <th class="text-muted-foreground hidden px-5 py-3 text-left text-xs font-medium sm:table-cell">
                      Qyteti
                    </th>
                    <th class="text-muted-foreground px-5 py-3 text-left text-xs font-medium">
                      Plani
                    </th>
                    <th class="text-muted-foreground px-5 py-3 text-right text-xs font-medium">
                      Fatura
                    </th>
                    <th class="text-muted-foreground hidden px-5 py-3 text-right text-xs font-medium md:table-cell">
                      Regjistruar
                    </th>
                  </tr>
                </thead>
                <tbody class="divide-y">
                  {businesses.map((b) => (
                    <tr class="hover:bg-muted/40 transition-colors">
                      <td class="max-w-[16rem] truncate px-5 py-3 font-medium">
                        {b.business_name ?? (
                          <span class="text-muted-foreground italic">pa emër</span>
                        )}
                      </td>
                      <td class="text-muted-foreground hidden px-5 py-3 sm:table-cell">
                        {b.city ?? '—'}
                      </td>
                      <td class="px-5 py-3">
                        <span
                          class:list={[
                            'rounded-full px-2 py-0.5 text-[11px] font-bold',
                            b.is_pro
                              ? 'bg-brand/15 text-primary'
                              : 'bg-muted text-muted-foreground',
                          ]}
                        >
                          {b.is_pro ? 'PRO' : 'FALAS'}
                        </span>
                      </td>
                      <td class="px-5 py-3 text-right tabular-nums">{b.invoice_count}</td>
                      <td class="text-muted-foreground hidden px-5 py-3 text-right md:table-cell">
                        {formatDate(b.created_at)}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
      </section>
    </div>

    <!-- Side rail -->
    <aside class="flex flex-col gap-6">
      <section class="bg-card ring-border rounded-xl p-5 ring-1">
        <h2 class="text-sm font-semibold">Numra të tjerë</h2>
        <dl class="mt-4 flex flex-col gap-3 text-sm">
          {
            secondary.map((row) => (
              <div class="flex items-center justify-between gap-3">
                <dt class="text-muted-foreground">{row.label}</dt>
                <dd class="font-medium tabular-nums">{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="bg-card ring-border rounded-xl p-5 ring-1">
        <h2 class="text-sm font-semibold">Të ardhurat</h2>
        <dl class="mt-4 flex flex-col gap-3 text-sm">
          {
            revenue.map((row) => (
              <div class="flex items-center justify-between gap-3">
                <dt class="text-muted-foreground">{row.label}</dt>
                <dd class="font-medium tabular-nums">{row.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section class="bg-card ring-border rounded-xl p-5 ring-1">
        <h2 class="text-sm font-semibold">Rritja</h2>
        <dl class="mt-4 flex flex-col gap-3 text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-muted-foreground">Të rinj (7 ditë)</dt>
            <dd class="font-medium tabular-nums">{num(s.new_users_7d)}</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-muted-foreground">Të rinj (30 ditë)</dt>
            <dd class="font-medium tabular-nums">{num(s.new_users_30d)}</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-muted-foreground">Aktivë (7 ditë)</dt>
            <dd class="font-medium tabular-nums">{num(s.active_users_7d)}</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-muted-foreground">Listë pritjeje (7 ditë)</dt>
            <dd class="font-medium tabular-nums">{num(s.waitlist_7d)}</dd>
          </div>
        </dl>
      </section>

      <section class="border-primary/25 bg-accent/40 rounded-xl border p-5">
        <div class="flex items-start gap-2.5">
          <Icon name="shield-check" class="text-primary mt-0.5 size-4 shrink-0" />
          <p class="text-muted-foreground text-xs leading-relaxed">
            Kjo faqe lexon vetëm shifra të përmbledhura. Faturat, NIPT-et dhe kontaktet e
            bizneseve mbeten të palexueshme — RLS nuk hiqet për adminët.
          </p>
        </div>
      </section>
    </aside>
  </div>
</AdminLayout>
