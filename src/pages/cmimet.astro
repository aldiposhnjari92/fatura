---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Pricing2 from '@/components/blocks/pricing-2.astro';
import Cta1 from '@/components/blocks/cta-1.astro';
import { TERM_CHOICES } from '@/lib/payments';
import { marketingPlans } from '@/lib/marketing-plans';
import { Section, SectionContainer } from '@/components/ui/section';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import { Icon } from '@/components/ui/icon';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/ui/table';

export const prerender = true;

/* The pricing page sells the same three plans in its own words. */
const plans = marketingPlans({
  free: {
    description: 'Përgjithmonë. Pa kartë krediti.',
    features: [
      '5 fatura në muaj',
      'Klientë të palimituar',
      'PDF me logo dhe NIPT',
      'TVSH dhe zbritje',
    ],
  },
  starter: { description: 'Kur 5 fatura nuk mjaftojnë më.' },
});


const rows = [
  { label: 'Fatura në muaj', free: '5', starter: '30', pro: 'Të palimituara' },
  {
    label: 'Klientë të ruajtur',
    free: 'Të palimituar',
    starter: 'Të palimituar',
    pro: 'Të palimituar',
  },
  { label: 'PDF me logon tënde', free: true, starter: true, pro: true },
  { label: 'NIPT në faturë', free: true, starter: true, pro: true },
  { label: 'TVSH dhe zbritje', free: true, starter: true, pro: true },
  { label: 'Numërim automatik i faturave', free: true, starter: true, pro: true },
  { label: 'Historik i plotë i faturave', free: true, starter: true, pro: true },
  { label: 'Prerje dhe rregullim i logos', free: true, starter: true, pro: true },
  { label: 'Të dhëna të ruajtura në BE', free: true, starter: true, pro: true },
  { label: 'Anulim në çdo moment', free: '—', starter: true, pro: true },
  {
    label: 'Mbështetje në WhatsApp',
    free: 'Standarde',
    starter: 'Standarde',
    pro: 'Me përparësi',
  },
];
---

<MarketingLayout
  title="Çmimet — Fatura.co"
  description="Fillo falas me 5 fatura në muaj. Starter me 30 fatura për 1000 Lekë në muaj, Pro me fatura të palimituara për 2000 Lekë. Pa kontratë, anulo kur të duash."
>
  <Pricing2
    title="Çmime pa surpriza"
    description="Fillo falas sot. Paguaj vetëm kur fatura e gjashtë e muajit të bëhet e nevojshme."
    plans={plans}
    terms={TERM_CHOICES}
  />

  <Section class="bg-ground">
    <SectionContainer class="max-w-5xl gap-6" data-reveal>
      <SectionHeading
        eyebrow="Krahasimi"
        title="Çfarë ndryshon mes planeve"
        description="I njëjti dokument në të tre planet. Ndryshon vetëm sa fatura mund të lëshosh."
      />

      {/*
        A comparison grid, not a data list: no zebra fill, no row hover, and a
        rule under every row including the last — hence the overrides.
      */}
      <Table class="min-w-[620px] border-collapse">
        <TableHeader class="bg-transparent">
          <TableRow class="hover:bg-transparent">
            <TableHead class="text-foreground px-0 py-3 text-sm font-semibold">
              Veçoria
            </TableHead>
            <TableHead class="text-foreground w-28 px-0 py-3 text-center text-sm font-semibold">
              Falas
            </TableHead>
            <TableHead class="text-foreground w-28 px-0 py-3 text-center text-sm font-semibold">
              Starter
            </TableHead>
            <TableHead class="text-primary w-28 px-0 py-3 text-center text-sm font-semibold">
              Pro
            </TableHead>
          </TableRow>
        </TableHeader>
        <TableBody class="divide-y-0">
          {
            rows.map((row) => (
              <TableRow class="border-b hover:bg-transparent">
                <TableCell class="text-muted-foreground py-3 pr-4 pl-0">{row.label}</TableCell>
                {/*
                  Same cell three times, so the tick/dash rendering cannot
                  drift between columns as the table grows.
                */}
                {([row.free, row.starter, row.pro] as (string | boolean)[]).map(
                  (value, index) => (
                    <TableCell
                      class:list={[
                        'px-0 py-3 text-center',
                        index === 2 && 'font-medium',
                      ]}
                    >
                      {typeof value === 'boolean' ? (
                        value ? (
                          <Icon name="check" class="text-primary inline-block size-4" />
                        ) : (
                          <span class="text-muted-foreground">—</span>
                        )
                      ) : (
                        value
                      )}
                    </TableCell>
                  )
                )}
              </TableRow>
            ))
          }
        </TableBody>
      </Table>

      <div class="grid gap-4 sm:grid-cols-3" data-stagger>
        {
          [
            {
              icon: 'landmark',
              title: 'Transfertë bankare',
              body: 'Aktive. Merr një referencë unike, bëj transfertën, plani aktivizohet brenda 24 orëve pune.',
            },
            {
              icon: 'calendar-check',
              title: 'Mujor ose vjetor',
              body: 'Paguaj muaj pas muaji, ose një vit me një transfertë të vetme. Koha e re i shtohet asaj ekzistuese.',
            },
            {
              icon: 'undo-2',
              title: 'Anulo kur të duash',
              body: 'Pas anulimit plani vazhdon deri në fund të periudhës së paguar, pastaj kthehesh te falas.',
            },
          ].map((item) => (
            <div class="bg-card shadow-card lift rounded-2xl p-6">
              <span class="bg-accent text-primary flex size-9 items-center justify-center rounded-lg">
                <Icon name={item.icon} class="size-[1.05rem]" />
              </span>
              <h3 class="mt-3.5 text-sm font-semibold">{item.title}</h3>
              <p class="text-muted-foreground mt-1.5 text-sm leading-relaxed">
                {item.body}
              </p>
            </div>
          ))
        }
      </div>

      <p class="text-muted-foreground text-center text-sm">
        Pagesat me kartë dhe PayPal shtohen sapo të lidhet llogaria tregtare. Për
        çdo pyetje, shkruaj në
        <a class="text-primary font-medium underline" href="mailto:aldiposhnjari@gmail.com"
          >aldiposhnjari@gmail.com</a
        >.
      </p>
    </SectionContainer>
  </Section>

  <Cta1
    class="bg-brand-deep"
    title="Fillo sot, paguaj kur të rritesh"
    description="Krijo llogarinë falas dhe shkarko faturën e parë brenda pak minutash."
    buttons={[
      { label: 'Krijo llogari falas', href: '/regjistrohu', 'data-auth-show': 'anon' },
      {
        label: 'Shko te paneli',
        href: '/app',
        variant: 'default',
        'data-auth-show': 'user',
      },
    ]}
  />
</MarketingLayout>
