---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Pricing2 from '@/components/blocks/pricing-2.astro';
import Cta1 from '@/components/blocks/cta-1.astro';
import { Section, SectionContainer } from '@/components/ui/section';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import { Icon } from '@/components/ui/icon';

export const prerender = true;

const plans = [
  {
    name: 'Falas',
    description: 'Përgjithmonë. Pa kartë krediti.',
    price: 0,
    currency: 'ALL',
    unit: 'muaj',
    features: [
      '5 fatura në muaj',
      'Klientë të palimituar',
      'PDF me logo dhe NIPT',
      'Fatura shqip dhe anglisht',
    ],
    note: 'Pa kartë krediti',
    button: { label: 'Fillo falas', href: '/regjistrohu', variant: 'outline' as const },
    authedButton: {
      label: 'Shko te paneli',
      href: '/app',
      variant: 'outline' as const,
    },
  },
  {
    name: 'Pro',
    description: 'Anulo kur të duash.',
    price: 2000,
    currency: 'ALL',
    unit: 'muaj',
    features: [
      'Fatura të palimituara',
      'Gjithçka nga plani falas',
      'Mbështetje me përparësi në WhatsApp',
      'Veçoritë e reja të parët',
    ],
    featured: true,
    badge: 'Më i zgjedhuri',
    note: 'Anulo kur të duash',
    button: { label: 'Fillo me Pro', href: '/regjistrohu?plan=pro&muaj=1' },
    authedButton: { label: 'Kalo në Pro', href: '/app/abonimi?muaj=1' },
  },
];

const rows = [
  { label: 'Fatura në muaj', free: '5', pro: 'Të palimituara' },
  { label: 'Klientë të ruajtur', free: 'Të palimituar', pro: 'Të palimituar' },
  { label: 'PDF me logon tënde', free: true, pro: true },
  { label: 'NIPT në faturë', free: true, pro: true },
  { label: 'TVSH dhe zbritje', free: true, pro: true },
  { label: 'Fatura shqip / anglisht', free: true, pro: true },
  { label: 'Numërim automatik i faturave', free: true, pro: true },
  { label: 'Historik i plotë i faturave', free: true, pro: true },
  { label: 'Prerje dhe rregullim i logos', free: true, pro: true },
  { label: 'Të dhëna të ruajtura në BE', free: true, pro: true },
  { label: 'Anulim në çdo moment', free: '—', pro: true },
  { label: 'Mbështetje në WhatsApp', free: 'Standarde', pro: 'Me përparësi' },
];
---

<MarketingLayout
  title="Çmimet — Fatura.co"
  description="Fillo falas me 5 fatura në muaj. Plani Pro me fatura të palimituara për 2000 Lekë në muaj. Pa kontratë, anulo kur të duash."
>
  <Pricing2
    title="Çmime pa surpriza"
    description="Fillo falas sot. Kalo në Pro vetëm kur fatura e gjashtë e muajit të bëhet e nevojshme."
    plans={plans}
  />

  <Section class="bg-muted/40">
    <SectionContainer class="max-w-4xl gap-6" data-reveal>
      <SectionHeading
        eyebrow="Krahasimi"
        title="Çfarë ndryshon mes planeve"
        description="I njëjti dokument në të dy planet. Ndryshon vetëm sa fatura mund të lëshosh."
      />

      <div class="overflow-x-auto">
        <table class="w-full min-w-[520px] border-collapse text-sm">
          <thead>
            <tr class="border-b">
              <th class="py-3 text-left font-semibold">Veçoria</th>
              <th class="w-32 py-3 text-center font-semibold">Falas</th>
              <th class="text-primary w-32 py-3 text-center font-semibold">Pro</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr class="border-b">
                  <td class="text-muted-foreground py-3 pr-4">{row.label}</td>
                  <td class="py-3 text-center">
                    {typeof row.free === 'boolean' ? (
                      row.free ? (
                        <Icon name="check" class="text-primary inline-block size-4" />
                      ) : (
                        <span class="text-muted-foreground">—</span>
                      )
                    ) : (
                      row.free
                    )}
                  </td>
                  <td class="py-3 text-center font-medium">
                    {typeof row.pro === 'boolean' ? (
                      row.pro ? (
                        <Icon name="check" class="text-primary inline-block size-4" />
                      ) : (
                        <span class="text-muted-foreground">—</span>
                      )
                    ) : (
                      row.pro
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="grid gap-4 sm:grid-cols-3" data-stagger>
        {
          [
            {
              icon: 'landmark',
              title: 'Transfertë bankare',
              body: 'Aktive. Merr një referencë unike, bëj transfertën, Pro aktivizohet brenda 24 orëve pune.',
            },
            {
              icon: 'calendar-check',
              title: '1, 6 ose 12 muaj',
              body: 'Paguaj për sa muaj të duash me një transfertë të vetme. Koha e re i shtohet asaj ekzistuese.',
            },
            {
              icon: 'undo-2',
              title: 'Anulo kur të duash',
              body: 'Pas anulimit Pro vazhdon deri në fund të periudhës së paguar, pastaj kthehesh te falas.',
            },
          ].map((item) => (
            <div class="bg-card ring-border lift rounded-2xl p-5 ring-1">
              <span class="bg-accent text-primary flex size-9 items-center justify-center rounded-lg">
                <Icon name={item.icon} class="size-[1.05rem]" />
              </span>
              <h3 class="mt-3.5 text-sm font-semibold">{item.title}</h3>
              <p class="text-muted-foreground mt-1.5 text-sm leading-relaxed">
                {item.body}
              </p>
            </div>
          ))
        }
      </div>

      <p class="text-muted-foreground text-center text-sm">
        Pagesat me kartë dhe PayPal shtohen sapo të lidhet llogaria tregtare. Për
        çdo pyetje, shkruaj në
        <a class="text-primary font-medium underline" href="mailto:pershendetje@fatura.co"
          >pershendetje@fatura.co</a
        >.
      </p>
    </SectionContainer>
  </Section>

  <Cta1
    class="dark bg-ink"
    title="Fillo sot, paguaj kur të rritesh"
    description="Krijo llogarinë falas dhe shkarko faturën e parë brenda pak minutash."
    buttons={[
      { label: 'Krijo llogari falas', href: '/regjistrohu', 'data-auth-show': 'anon' },
      {
        label: 'Shko te paneli',
        href: '/app',
        variant: 'default',
        'data-auth-show': 'user',
      },
    ]}
  />
</MarketingLayout>
