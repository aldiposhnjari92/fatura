---
import BaseLayout from './BaseLayout.astro';
import AdminShell from '@/components/react/AdminShell';
import type { AdminNavGroup } from '@/components/react/AdminShell';
import { useTranslations } from '@/lib/i18n';

export interface Props {
  title: string;
  heading: string;
  subheading?: string;
  active: 'overview' | 'invoices' | 'activity' | 'users' | 'payments' | 'waitlist' | 'audit';
  /** Pending-payment count, rendered as a badge on the Payments item. */
  pendingCount?: number;
}

const { title, heading, subheading, active, pendingCount = 0 } = Astro.props;
const { profile, user } = Astro.locals;
const t = useTranslations();

/*
  The operator console runs on the same shell as /app — the shadcn rail, the
  collapse state, ⌘B and the sticky bar — but through its own component rather
  than a mode of AppShell. The two consoles share a design; they must not share
  a payload, or every operator control sits one boolean away from the customer
  chrome. See src/components/react/AdminShell.tsx.

  This file is now only the data: which items this role may see, and the
  strings. The markup that used to be written twice here — a sliding sheet on
  a phone, a static column on a desktop — is the sidebar primitive's job now.

  A manager only ever sees the invoice-activity items. The middleware and the
  RPCs both enforce this independently; hiding the links is the courtesy layer,
  not the control.
*/
const isAdmin = Boolean(profile?.is_admin);

const overviewItem = {
  key: 'overview',
  href: '/admin',
  label: t('adm.overview'),
  icon: 'layout-dashboard',
} as const;

const activityItem = {
  key: 'activity',
  href: '/admin/aktiviteti',
  label: 'Aktiviteti',
  icon: 'activity',
} as const;

const invoicesItem = {
  key: 'invoices',
  href: '/admin/faturat',
  label: t('adm.invoiceActivity'),
  icon: 'file-text',
} as const;

const nav: AdminNavGroup[] = isAdmin
  ? [
      { group: null, items: [overviewItem] },
      { group: 'Aktiviteti', items: [activityItem, invoicesItem] },
      {
        group: 'Administrimi',
        items: [
          { key: 'users', href: '/admin/perdoruesit', label: t('adm.users'), icon: 'users' },
          {
            key: 'payments',
            href: '/admin/pagesat',
            label: t('adm.payments'),
            icon: 'credit-card',
          },
          {
            key: 'waitlist',
            href: '/admin/lista',
            label: t('adm.waitlist'),
            icon: 'clipboard-list',
          },
          {
            key: 'audit',
            href: '/admin/regjistri',
            label: t('adm.audit'),
            icon: 'scroll-text',
          },
        ],
      },
    ]
  : [{ group: null, items: [invoicesItem, activityItem] }];

/*
  The rail's collapse state, read on the server from the same cookie the
  customer shell uses — so an operator who collapses the rail in one console
  finds it collapsed in the other, which is the behaviour a single design
  implies.
*/
const defaultSidebarOpen = Astro.cookies.get('sidebar_state')?.value !== 'false';
---

<BaseLayout title={title} noindex={true}>
  <AdminShell
    heading={heading}
    subheading={subheading}
    active={active}
    nav={nav}
    pendingCount={pendingCount}
    isAdmin={isAdmin}
    businessName={profile?.business_name ?? null}
    email={user?.email ?? ''}
    backToAppHref="/app?klient=1"
    labels={{
      console: t('adm.console'),
      backToApp: t('nav.backToApp'),
      signOut: t('nav.signOut'),
      pendingPayments: t('adm.payments'),
    }}
    defaultSidebarOpen={defaultSidebarOpen}
    client:load
  >
    <Fragment slot="actions">
      <slot name="actions" />
    </Fragment>
    <slot />
  </AdminShell>
</BaseLayout>
