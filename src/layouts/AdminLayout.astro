---
import BaseLayout from './BaseLayout.astro';
import Logo from '@/components/Logo.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import ActivityStream from '@/components/react/ActivityStream';
import { Icon } from '@/components/ui/icon';
import { initials } from '@/lib/utils';
import { useTranslations } from '@/lib/i18n';

export interface Props {
  title: string;
  heading: string;
  subheading?: string;
  active: 'overview' | 'invoices' | 'activity' | 'users' | 'payments' | 'waitlist' | 'audit';
  /** Pending-payment count, rendered as a badge on the Payments item. */
  pendingCount?: number;
}

const { title, heading, subheading, active, pendingCount = 0 } = Astro.props;
const { profile, user, lang } = Astro.locals;
const t = useTranslations(lang);
const pathname = Astro.url.pathname;

/*
  A separate shell from /app on purpose. The client dashboard and the operator
  console have different jobs, and rendering the admin tools inside the customer
  chrome makes it far too easy to ship a control to the wrong audience. Dark
  chrome so it is never mistaken for the customer view.

  Mobile used to get the desktop sidebar stacked on top of the page: a tall ink
  block, a horizontally scrolling row of tabs, and — because the footer was
  `hidden lg:block` — no way at all to sign out or return to the app from a
  phone. It is now a compact bar that opens an off-canvas drawer.

  The nav loop is written twice, once per breakpoint, because the two shells
  are genuinely different elements rather than one restyled: a fixed sliding
  sheet on a phone, a static column on a desktop. The data is declared once
  here, so only the markup repeats.
*/
/*
  A manager only ever sees the invoice-activity item. The middleware and the
  RPCs both enforce this independently; hiding the links is the courtesy layer,
  not the control.
*/
const isAdmin = Boolean(profile?.is_admin);

const adminNav = [
  { key: 'overview', href: '/admin', label: t('adm.overview'), icon: 'layout-dashboard' },
  { key: 'users', href: '/admin/perdoruesit', label: t('adm.users'), icon: 'users' },
  { key: 'payments', href: '/admin/pagesat', label: t('adm.payments'), icon: 'credit-card' },
  { key: 'waitlist', href: '/admin/lista', label: t('adm.waitlist'), icon: 'clipboard-list' },
  { key: 'audit', href: '/admin/regjistri', label: t('adm.audit'), icon: 'scroll-text' },
] as const;

const activityItem = {
  key: 'activity',
  href: '/admin/aktiviteti',
  label: 'Aktiviteti',
  icon: 'activity',
} as const;

const invoicesItem = {
  key: 'invoices',
  href: '/admin/faturat',
  label: t('adm.invoiceActivity'),
  icon: 'file-text',
} as const;

const nav = isAdmin
  ? [adminNav[0], activityItem, invoicesItem, ...adminNav.slice(1)]
  : [invoicesItem, activityItem];

const navLink =
  'flex items-center gap-2.5 rounded-lg px-3 py-2.5 text-sm font-medium whitespace-nowrap transition-colors';
const navActive = 'bg-brand/15 text-brand';
const navIdle = 'text-mist/65 hover:bg-white/5 hover:text-mist';
const footerLink =
  'text-mist/65 hover:text-mist flex w-full items-center gap-2.5 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors hover:bg-white/5';
---

<BaseLayout title={title} noindex={true}>
  <div class="flex min-h-screen flex-col lg:flex-row">
    {/*
      Mobile: a real off-canvas drawer.

      Driven by a checkbox + labels rather than script, so it still opens with
      JavaScript unavailable — and unlike the <details> it replaces, the panel
      is `fixed`, so opening it slides a sheet over the page instead of pushing
      the whole console down. The backdrop is a second <label> for the same
      checkbox, which is what gives us tap-outside-to-close without a handler.

      The bar is a fixed `h-14`, not content-sized, because the content header
      below sticks at exactly that offset. Both were pinned to top-0 before, so
      the heading slid underneath the bar on scroll.
    */}
    <input
      id="admin-nav"
      type="checkbox"
      class="peer sr-only"
      aria-label={t('nav.menu')}
    />

    <div
      class="bg-ink text-mist sticky top-0 z-40 flex h-14 shrink-0 items-center justify-between gap-3 px-4 lg:hidden"
    >
      <a href="/admin" class="flex items-center gap-2.5">
        <Logo invert />
        <span
          class="bg-brand/15 text-brand rounded-full px-2 py-0.5 text-[10px] font-bold tracking-wide"
        >
          {isAdmin ? 'ADMIN' : 'MENAXHER'}
        </span>
      </a>

      <span class="flex items-center gap-2">
        {
          pendingCount > 0 && (
            <span class="bg-brand text-ink rounded-full px-1.5 py-0.5 text-[10px] font-bold">
              {pendingCount}
            </span>
          )
        }
        <span class="text-mist">
          <ActivityStream lang={lang} variant="bell" client:idle />
        </span>
        <label
          for="admin-nav"
          class="cursor-pointer rounded-lg p-1.5 hover:bg-white/5"
          aria-label={t('nav.menu')}
        >
          <Icon name="menu" class="size-5" />
        </label>
      </span>
    </div>

    {/* Backdrop — closes the drawer when tapped. */}
    <label
      for="admin-nav"
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 z-40 bg-black/60 opacity-0 transition-opacity duration-300 peer-checked:pointer-events-auto peer-checked:opacity-100 lg:hidden"
    ></label>

    <aside
      class="bg-ink text-mist fixed inset-y-0 left-0 z-50 flex w-72 max-w-[85vw] -translate-x-full flex-col overflow-y-auto shadow-2xl transition-transform duration-300 ease-out peer-checked:translate-x-0 lg:hidden"
    >
      <div class="flex h-14 shrink-0 items-center justify-between gap-3 px-4">
        <span class="flex items-center gap-2.5">
          <Logo invert />
          <span
            class="bg-brand/15 text-brand rounded-full px-2 py-0.5 text-[10px] font-bold tracking-wide"
          >
            ADMIN
          </span>
        </span>
        <label
          for="admin-nav"
          class="cursor-pointer rounded-lg p-1.5 hover:bg-white/5"
          aria-label={t('nav.close')}
        >
          <Icon name="x" class="size-5" />
        </label>
      </div>

      <nav class="flex flex-col gap-1 border-t border-white/10 px-3 pt-3">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={active === item.key ? 'page' : undefined}
              class:list={[navLink, active === item.key ? navActive : navIdle]}
            >
              <Icon name={item.icon} class="size-4 shrink-0" />
              <span>{item.label}</span>
              {item.key === 'payments' && pendingCount > 0 && (
                <span class="bg-brand text-ink ml-auto rounded-full px-1.5 py-0.5 text-[10px] font-bold">
                  {pendingCount}
                </span>
              )}
            </a>
          ))
        }
      </nav>

      <div class="mt-auto border-t border-white/10 p-3">
        <div class="flex items-center gap-2.5 rounded-lg px-3 py-2.5">
          <span
            class="bg-brand/15 text-brand flex size-8 shrink-0 items-center justify-center rounded-full text-[11px] font-bold"
          >
            {initials(profile?.business_name ?? user?.email)}
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-xs font-medium">{profile?.business_name}</p>
            <p class="text-mist/45 truncate text-[11px]">{user?.email}</p>
          </div>
        </div>

        <a href="/app?klient=1" class={footerLink}>
          <Icon name="arrow-left" class="size-4" />
          {t('nav.backToApp')}
        </a>

        <form method="POST" action="/auth/signout">
          <button type="submit" class={footerLink}>
            <Icon name="log-out" class="size-4" /> {t('nav.signOut')}
          </button>
        </form>

        <div class="px-3 pt-2">
          <LanguageSwitcher
            lang={lang}
            pathname={pathname}
            class="border-white/15 text-mist/70"
          />
        </div>
      </div>
    </aside>

    {/* ---------- Desktop: persistent sidebar ---------- */}
    <aside
      class="bg-ink text-mist hidden shrink-0 flex-col lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-64"
    >
      <div class="flex items-center justify-between gap-3 px-5 py-5">
        <a href="/admin" class="flex items-center gap-2.5" aria-label={t('adm.console')}>
          <Logo invert />
        </a>
        <span
          class="bg-brand/15 text-brand rounded-full px-2 py-0.5 text-[10px] font-bold tracking-wide"
        >
          {isAdmin ? 'ADMIN' : 'MENAXHER'}
        </span>
      </div>

      <nav class="flex flex-col gap-1 px-3 pb-3">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={active === item.key ? 'page' : undefined}
              class:list={[navLink, active === item.key ? navActive : navIdle]}
            >
              <Icon name={item.icon} class="size-4 shrink-0" />
              <span>{item.label}</span>
              {item.key === 'payments' && pendingCount > 0 && (
                <span class="bg-brand text-ink ml-auto rounded-full px-1.5 py-0.5 text-[10px] font-bold">
                  {pendingCount}
                </span>
              )}
            </a>
          ))
        }
      </nav>

      <div class="mt-auto border-t border-white/10 p-3">
        <a href="/app?klient=1" class={footerLink}>
          <Icon name="arrow-left" class="size-4" />
          {t('nav.backToApp')}
        </a>

        <div class="mt-2 flex items-center gap-2.5 rounded-lg px-3 py-2.5">
          <span
            class="bg-brand/15 text-brand flex size-8 shrink-0 items-center justify-center rounded-full text-[11px] font-bold"
          >
            {initials(profile?.business_name ?? user?.email)}
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-xs font-medium">{profile?.business_name}</p>
            <p class="text-mist/45 truncate text-[11px]">{user?.email}</p>
          </div>
        </div>

        <form method="POST" action="/auth/signout">
          <button type="submit" class={footerLink}>
            <Icon name="log-out" class="size-4" /> {t('nav.signOut')}
          </button>
        </form>

        <div class="px-3 pt-2">
          <LanguageSwitcher
            lang={lang}
            pathname={pathname}
            class="border-white/15 text-mist/70"
          />
        </div>
      </div>
    </aside>

    {/* ---------- Content ---------- */}
    <div class="bg-muted/40 flex min-w-0 flex-1 flex-col">
      <header class="bg-background/85 sticky top-14 z-30 border-b backdrop-blur-md lg:top-0">
        <div
          class="flex flex-col gap-3 px-4 py-4 sm:px-6 sm:py-5 md:flex-row md:flex-wrap md:items-end md:justify-between"
        >
          <div class="min-w-0">
            <h1 class="truncate text-lg font-semibold tracking-tight sm:text-2xl">
              {heading}
            </h1>
            {
              subheading && (
                <p class="text-muted-foreground mt-1 text-sm">{subheading}</p>
              )
            }
          </div>
          <div class="flex items-center gap-2">
            <span class="hidden lg:block">
              <ActivityStream lang={lang} variant="bell" client:idle />
            </span>
            <slot name="actions" />
          </div>
        </div>
      </header>

      <main class="min-w-0 flex-1 px-4 py-5 sm:px-6 sm:py-6">
        <slot />
      </main>

      {/* Live notifications, console-wide. The table's RLS is manager-only, so
          the subscription yields nothing to anyone else. */}
      <ActivityStream lang={lang} variant="toast" client:idle />
    </div>
  </div>
</BaseLayout>
