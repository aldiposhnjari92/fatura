---
import Analytics from '@vercel/analytics/astro';

import '@/styles/globals.css';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Krijo fatura profesionale me NIPT dhe logo në 2 minuta, nga telefoni. Falas për bizneset e vogla dhe të vetëpunësuarit në Shqipëri.',
  canonical,
  image = '/og.png',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://fatura.co';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="sq" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#222831" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fatura.co" />
    <meta property="og:locale" content="sq_AL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />

    {/*
      Runs before first paint so the header/CTAs never flash the wrong state.
      Presence of the session cookie is treated as "probably signed in" — it is
      only a navigation affordance. If the token turns out to be expired the
      middleware bounces /app to /login, which is self-correcting. The cookie is
      not httpOnly by design: @supabase/ssr needs the browser client to read it.
    */}
    <script is:inline>
      (function () {
        try {
          var authed = document.cookie
            .split(';')
            .some(function (c) {
              return c.trim().indexOf('sb-fatura') === 0;
            });
          document.documentElement.setAttribute('data-auth', authed ? 'user' : 'anon');
        } catch (e) {
          document.documentElement.setAttribute('data-auth', 'anon');
        }

        /*
          Reveal-on-scroll hides elements with opacity:0 until the observer
          runs. Gate that behind a marker set here, before first paint, so a
          visitor with JavaScript disabled — or with reduced motion asked for —
          gets the fully visible page instead of a blank one.
        */
        try {
          var still =
            window.matchMedia &&
            window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!still) document.documentElement.setAttribute('data-motion', 'on');
        } catch (e) {}
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground">
    <slot />

    <script is:inline>
      /*
        Scroll reveal.

        A rAF-throttled geometry check rather than IntersectionObserver: IO
        coalesces notifications, so an element flicked past between deliveries
        can be skipped and then sits at opacity:0 forever — a blank section is
        a far worse outcome than a missed animation. This tests position
        directly, so nothing can be missed, and it unbinds itself once every
        element has been revealed.

        Nothing runs unless the root element carries data-motion="on", which
        the head script sets only when JS is available and reduced motion has
        not been requested.
        All easing and timing lives in CSS.
      */
      (function () {
        var nodes = [].slice.call(
          document.querySelectorAll('[data-reveal], [data-stagger]')
        );
        if (!nodes.length) return;

        if (document.documentElement.getAttribute('data-motion') !== 'on') {
          for (var i = 0; i < nodes.length; i++) {
            nodes[i].setAttribute('data-shown', 'true');
          }
          return;
        }

        var queued = false;

        function check() {
          queued = false;
          var fold = window.innerHeight * 0.92;

          for (var i = nodes.length - 1; i >= 0; i--) {
            // Reveal once the top edge crosses into the fold, which also
            // covers anything already scrolled past (top < 0).
            if (nodes[i].getBoundingClientRect().top < fold) {
              nodes[i].setAttribute('data-shown', 'true');
              nodes.splice(i, 1);
            }
          }

          if (!nodes.length) {
            window.removeEventListener('scroll', onChange);
            window.removeEventListener('resize', onChange);
          }
        }

        function onChange() {
          if (queued) return;
          queued = true;
          window.requestAnimationFrame(check);
        }

        window.addEventListener('scroll', onChange, { passive: true });
        window.addEventListener('resize', onChange);
        check();
      })();
    </script>

    {/*
      Vercel Web Analytics. In production it loads `/_vercel/insights/script.js`
      and beacons to `/_vercel/insights/view` — both same-origin, so the CSP
      above already allows them without a new source expression. (In dev it
      reaches for va.vercel-scripts.com instead, which the CSP blocks; that
      build reports nothing anyway, so the only cost is a console warning.)

      What reaches Vercel is filtered first. The component reads
      `window.webAnalyticsBeforeSend`, so this has to be a plain inline script
      rather than a module: module scripts are deferred, and the hook has to
      exist before the analytics one runs.
    */}
    <script is:inline>
      /*
        Signed-in URLs are stripped of anything that identifies a record or a
        person before they leave the browser:

          • /app/faturat/<uuid> is a specific invoice. The route is the useful
            dimension; the id is not, and it is the customer's, not ours.
          • the query string behind /app and /admin carries `kerko` — whatever
            the user typed into search, which is routinely a client's name —
            and `next`, which is a path. Neither is worth measuring.

        Marketing URLs are left alone on purpose: their query strings are how
        utm_* attribution arrives, and there is nothing private in them.
      */
      window.webAnalyticsBeforeSend = function (event) {
        try {
          var url = new URL(event.url, window.location.origin);
          if (!/^\/(app|admin)(\/|$)/.test(url.pathname)) return event;

          url.pathname = url.pathname.replace(
            /\/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?=\/|$)/gi,
            '/[id]'
          );
          url.search = '';
          return { ...event, url: url.toString() };
        } catch (e) {
          // A URL we cannot parse is one we cannot vouch for: drop the event
          // rather than forward it unfiltered.
          return null;
        }
      };
    </script>
  </body>
</html>
