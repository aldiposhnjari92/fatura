---
import '@/styles/globals.css';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'Krijo fatura profesionale me NIPT dhe logo në 2 minuta, nga telefoni. Falas për bizneset e vogla dhe të vetëpunësuarit në Shqipëri.',
  canonical,
  image = '/og.png',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://fatura.co';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
---

<!doctype html>
<html lang="sq" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#222831" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fatura.co" />
    <meta property="og:locale" content="sq_AL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    />

    {/*
      Runs before first paint so the header/CTAs never flash the wrong state.
      Presence of the session cookie is treated as "probably signed in" — it is
      only a navigation affordance. If the token turns out to be expired the
      middleware bounces /app to /login, which is self-correcting. The cookie is
      not httpOnly by design: @supabase/ssr needs the browser client to read it.
    */}
    <script is:inline>
      (function () {
        try {
          var authed = document.cookie
            .split(';')
            .some(function (c) {
              return c.trim().indexOf('sb-fatura') === 0;
            });
          document.documentElement.setAttribute('data-auth', authed ? 'user' : 'anon');
        } catch (e) {
          document.documentElement.setAttribute('data-auth', 'anon');
        }
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground">
    <slot />
  </body>
</html>
