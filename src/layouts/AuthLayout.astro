---
import BaseLayout from './BaseLayout.astro';
import Logo from '@/components/Logo.astro';

export interface Props {
  title: string;
  description?: string;
  heading: string;
  subheading: string;
}

const { title, description, heading, subheading } = Astro.props;

const points = [
  'PDF me NIPT dhe logon tënde',
  'TVSH dhe zbritje të llogaritura vetë',
  'Numërim automatik FAT-2025-001',
];
---

<BaseLayout title={title} description={description} noindex={true}>
  <div class="grid min-h-screen lg:grid-cols-2">
    <!-- Form side -->
    <div class="flex flex-col">
      <header class="container flex h-[68px] items-center lg:px-12">
        <a href="/" aria-label="Fatura.co — ballina"><Logo /></a>
      </header>

      <main class="flex flex-1 items-center justify-center px-6 py-10 lg:px-12">
        <div class="w-full max-w-sm">
          <h1 class="text-2xl font-bold tracking-[-0.02em]">{heading}</h1>
          <p class="mt-2 text-sm text-muted-foreground">{subheading}</p>

          <div class="mt-8">
            <slot />
          </div>
        </div>
      </main>
    </div>

    <!-- Brand side: dark, teal-accented, hidden on small screens -->
    <aside class="relative hidden overflow-hidden bg-ink text-mist lg:block">
      <div
        class="pointer-events-none absolute -right-32 -top-32 h-[30rem] w-[30rem] rounded-full bg-brand/20 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.06]"
        aria-hidden="true"
        style="background-image:linear-gradient(#EEEEEE 1px,transparent 1px),linear-gradient(90deg,#EEEEEE 1px,transparent 1px);background-size:64px 64px"
      >
      </div>

      <div class="relative flex h-full flex-col justify-center px-14 py-16">
        <p class="eyebrow text-brand">
          <span class="h-px w-8 bg-brand"></span>
          Fatura.co
        </p>

        <p class="mt-6 max-w-md text-balance text-3xl font-extrabold leading-tight tracking-[-0.02em]">
          Fatura profesionale në <span class="text-brand">2 minuta</span>, jo 2 orë.
        </p>

        <ul class="mt-10 space-y-4">
          {
            points.map((point) => (
              <li class="flex items-start gap-3 text-sm text-mist/75">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand/20 text-xs font-bold text-brand">
                  ✓
                </span>
                {point}
              </li>
            ))
          }
        </ul>

        <p class="mt-12 text-sm text-mist/45">
          PDF-ja krijohet në pajisjen tënde. Të dhënat e faturës nuk shkojnë kurrë te një
          server i tretë.
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
