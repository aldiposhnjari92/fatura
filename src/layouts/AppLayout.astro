---
import BaseLayout from './BaseLayout.astro';
import Logo from '@/components/Logo.astro';
import UserMenu from '@/components/react/UserMenu';

export interface Props {
  title: string;
  heading?: string;
  active?: 'dashboard' | 'invoices' | 'clients' | 'settings';
}

const { title, heading, active = 'dashboard' } = Astro.props;
// All three come from the single app_bootstrap() call in the middleware —
// this layout issues no queries of its own.
const { profile, user, invoicesThisMonth } = Astro.locals;

// For an admin, bare /app redirects to the console — so the in-app "Paneli"
// link carries the escape param and stays where the user already is.
const isAdmin = profile?.is_admin ?? false;
const dashboardHref = isAdmin ? '/app?klient=1' : '/app';

const nav = [
  { key: 'dashboard', href: dashboardHref, label: 'Paneli', icon: 'M3 12l9-9 9 9M5 10v10h14V10' },
  {
    key: 'invoices',
    href: '/app/faturat',
    label: 'Faturat',
    icon: 'M6 2h9l5 5v15H6zM14 2v6h6M9 13h7M9 17h5',
  },
  {
    key: 'clients',
    href: '/app/klientet',
    label: 'Klientët',
    icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM3 21v-2a6 6 0 016-6h6a6 6 0 016 6v2',
  },
  {
    key: 'settings',
    href: '/app/cilesimet',
    label: 'Cilësimet',
    icon: 'M12 15a3 3 0 100-6 3 3 0 000 6zM19.4 15a1.7 1.7 0 00.3 1.9l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.9-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1A1.7 1.7 0 008.9 19a1.7 1.7 0 00-1.9.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.9 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1A1.7 1.7 0 004.6 8.3a1.7 1.7 0 00-.3-1.9l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.9.3H9a1.7 1.7 0 001-1.5V2a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.9-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.9V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z',
  },
] as const;
---

<BaseLayout title={title} noindex={true}>
  <div class="flex min-h-screen flex-col bg-muted/40">
    <header class="sticky top-0 z-40 border-b bg-background/85 backdrop-blur-md">
      <div class="container flex h-16 items-center justify-between gap-4">
        <div class="flex items-center gap-8">
          <a href={dashboardHref} aria-label="Fatura.co — paneli"><Logo /></a>

          <nav
            class="hidden items-center gap-1 md:flex"
            aria-label="Navigimi i aplikacionit"
          >
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={active === item.key ? 'page' : undefined}
                  class:list={[
                    'rounded-lg px-3 py-2 text-sm font-medium transition-colors',
                    active === item.key
                      ? 'bg-accent text-accent-foreground'
                      : 'text-muted-foreground hover:bg-muted hover:text-foreground',
                  ]}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>
        </div>

        <div class="flex items-center gap-2">
          <a
            href="/app/faturat/e-re"
            class="bg-primary text-primary-foreground hidden h-9 items-center justify-center rounded-lg px-4 text-sm font-semibold shadow-sm transition-opacity hover:opacity-90 sm:inline-flex"
          >
            + Faturë e re
          </a>

          <UserMenu
            businessName={profile?.business_name ?? null}
            email={user?.email ?? ''}
            logoUrl={profile?.logo_url ?? null}
            isPro={profile?.is_pro ?? false}
            isAdmin={profile?.is_admin ?? false}
            invoicesThisMonth={invoicesThisMonth}
            client:load
          />
        </div>
      </div>
    </header>

    <main class="container flex-1 py-8 pb-28 md:pb-10">
      {
        heading && (
          <h1 class="mb-6 text-2xl font-bold tracking-[-0.02em] sm:text-3xl">{heading}</h1>
        )
      }
      <slot />
    </main>

    <!-- Mobile bottom nav: this product lives on phones. -->
    <nav
      class="fixed inset-x-0 bottom-0 z-40 border-t bg-background/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-md md:hidden"
      aria-label="Navigimi mobil"
    >
      <div class="grid grid-cols-4">
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={active === item.key ? 'page' : undefined}
              class:list={[
                'flex flex-col items-center gap-1 py-2.5 text-[11px] font-medium transition-colors',
                active === item.key ? 'text-primary' : 'text-muted-foreground',
              ]}
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={item.icon} />
              </svg>
              {item.label}
            </a>
          ))
        }
      </div>
    </nav>

    <!-- Floating compose button, mobile only -->
    <a
      href="/app/faturat/e-re"
      class="fixed bottom-20 right-4 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-primary text-2xl font-light text-primary-foreground shadow-lg transition-transform hover:scale-105 md:hidden"
      aria-label="Faturë e re"
    >
      +
    </a>
  </div>
</BaseLayout>
