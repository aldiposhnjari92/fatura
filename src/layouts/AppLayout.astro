---
import { useTranslations } from '@/lib/i18n';
import BaseLayout from './BaseLayout.astro';
import AppShell from '@/components/react/AppShell';
import type { NavGroup, NavItem, NavKey } from '@/components/react/AppShell';
import { normalizeQuery } from '@/lib/search';

export interface Props {
  title: string;
  heading?: string;
  active?: NavKey;
}

const { title, heading, active = 'dashboard' } = Astro.props;
// All three come from the single app_bootstrap() call in the middleware —
// this layout issues no queries of its own.
const { profile, user, invoicesThisMonth, plan } = Astro.locals;
const t = useTranslations();

// For an admin, bare /app redirects to the console — so the in-app "Paneli"
// link carries the escape param and stays where the user already is.
const isAdmin = profile?.is_admin ?? false;
const dashboardHref = isAdmin ? '/app?klient=1' : '/app';

/*
  The invoice list runs the same filter from its own `kerko` param, so when the
  shell sits above a filtered list the field opens carrying that term rather
  than going blank the moment a search lands.
*/
const searchQuery =
  Astro.url.pathname === '/app/faturat' ? normalizeQuery(Astro.url.searchParams.get('kerko')) : '';

/*
  The rail's collapse state, read on the server.

  The shadcn sidebar writes `sidebar_state` from the browser and takes its
  starting state as a prop — which is the whole point of that arrangement: the
  first paint is already the right width, rather than rendering open and
  snapping shut once JavaScript has read the cookie back.
*/
const defaultSidebarOpen = Astro.cookies.get('sidebar_state')?.value !== 'false';

/*
  A persistent left rail rather than a top bar.

  The destinations are the same three as before plus the compose action; what
  changed is that they now sit in a labelled column, grouped by what the user
  is doing — the invoicing run, then the supporting records. A top bar has to
  hold everything on one line, so it flattens that distinction and caps the
  list at whatever fits beside the logo. The rail also frees the full width of
  the page header for the search field and the page's own actions.

  Settings still lives only in the account dropdown, not here. It is a
  set-once-and-forget screen, so it belongs with the account, which is also
  where a user goes looking for it.

  Below `lg` the rail is not rendered at all: a phone keeps the top bar and the
  bottom nav it already had, both built from this same list.
*/
const nav: NavGroup[] = [
  {
    group: null,
    items: [
      {
        key: 'dashboard',
        href: dashboardHref,
        label: t('nav.dashboard'),
        icon: 'layout-dashboard',
      },
    ],
  },
  {
    group: 'Faturimi',
    items: [
      { key: 'invoices', href: '/app/faturat', label: t('nav.invoices'), icon: 'file-text' },
      {
        key: 'new',
        href: '/app/faturat/e-re',
        label: t('nav.newInvoice'),
        icon: 'square-pen',
      },
    ],
  },
  {
    group: 'Regjistrat',
    items: [{ key: 'clients', href: '/app/klientet', label: t('nav.clients'), icon: 'users' }],
  },
];

// The three destinations the phone's bottom bar carries — compose has its own
// floating button down there, so it is left out.
const mobileNav: NavItem[] = [
  { key: 'dashboard', href: dashboardHref, label: t('nav.dashboard'), icon: 'layout-dashboard' },
  { key: 'invoices', href: '/app/faturat', label: t('nav.invoices'), icon: 'file-text' },
  { key: 'clients', href: '/app/klientet', label: t('nav.clients'), icon: 'users' },
];
---

<BaseLayout title={title} noindex={true}>
  {/*
    One island for the whole shell, not four.

    The sidebar is shadcn's, and that component is a context: the rail, the
    trigger in the bar, ⌘B and the width the page is offset by all read the
    same provider. The page arrives as a slot — server rendered, held in
    Astro's memoised static wrapper — so the islands inside a page hydrate
    normally and nothing out here re-renders them.

    client:load rather than client:idle: the trigger, the account menu and the
    phone's search are all dead controls until this has hydrated.
  */}
  <AppShell
    heading={heading}
    active={active}
    dashboardHref={dashboardHref}
    nav={nav}
    mobileNav={mobileNav}
    newInvoiceLabel={t('nav.newInvoice')}
    defaultSidebarOpen={defaultSidebarOpen}
    searchQuery={searchQuery}
    businessName={profile?.business_name ?? null}
    email={user?.email ?? ''}
    logoUrl={profile?.logo_url ?? null}
    plan={plan}
    proEndsOn={profile?.cancelled_at ? (profile?.pro_until ?? null) : null}
    isAdmin={isAdmin}
    invoicesThisMonth={invoicesThisMonth}
    client:load
  >
    <slot />
  </AppShell>
</BaseLayout>
