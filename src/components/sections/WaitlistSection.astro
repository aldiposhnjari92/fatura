---
import { Section, SectionContainer } from '@/components/ui/section';
import { Icon } from '@/components/ui/icon';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import { Card, CardContent } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';

// A plain HTML form posting to /api/waitlist — deliberately not a React island,
// so this section still ships zero JavaScript.
---

<Section id="lista" class="bg-muted/40">
  <SectionContainer>
    <div class="grid items-start gap-10 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-16">
      <div data-reveal>
        <SectionHeading
          eyebrow="Ndihmë falas"
          title="Do ndihmë për të filluar?"
          description="Lër numrin e WhatsApp-it dhe të kontaktojmë ne për ta ngritur bashkë llogarinë — pa pagesë."
          align="start"
        />

        <ul class="mt-8 flex flex-col gap-4">
          {
            [
              ['message-circle', 'Të shkruajmë në WhatsApp, jo email'],
              ['clock', 'Zakonisht brenda një dite pune'],
              ['badge-check', 'E ngremë bashkë llogarinë, pa pagesë'],
            ].map(([icon, text]) => (
              <li class="flex items-start gap-3">
                <span class="bg-accent text-primary mt-px flex size-7 shrink-0 items-center justify-center rounded-lg">
                  <Icon name={icon} class="size-3.5" />
                </span>
                <span class="text-foreground/85 text-sm leading-relaxed">{text}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <Card class="shadow-xl" data-reveal>
      <CardContent class="pt-6">
        <form
          method="POST"
          action="/api/waitlist"
          class="grid gap-5 text-left sm:grid-cols-2"
        >
          <div class="flex flex-col gap-2 sm:col-span-2">
            <Label for="business_name">Emri i biznesit</Label>
            <Input
              id="business_name"
              name="business_name"
              type="text"
              required
              maxlength="120"
              placeholder="p.sh. Bar Kafe Vlora"
              class="h-11"
            />
          </div>

          <div class="flex flex-col gap-2">
            <Label for="whatsapp">WhatsApp</Label>
            <Input
              id="whatsapp"
              name="whatsapp"
              type="tel"
              required
              maxlength="30"
              placeholder="+355 6X XXX XXXX"
              class="h-11"
            />
          </div>

          <div class="flex flex-col gap-2">
            <Label for="city">Qyteti</Label>
            <Input id="city" name="city" type="text" maxlength="60" value="Fier" class="h-11" />
          </div>

          <!-- Honeypot: bots fill it, humans never see it. -->
          <Input
            type="text"
            name="company_website"
            tabindex="-1"
            autocomplete="off"
            class="hidden"
            aria-hidden="true"
          />

          <div class="sm:col-span-2">
            <Button type="submit" size="lg" class="w-full">
              Më kontaktoni në WhatsApp
            </Button>
          </div>

          <p class="text-muted-foreground text-center text-xs sm:col-span-2">
            Nuk dërgojmë spam. Vetëm një mesazh për të të ndihmuar me faturën e parë.
          </p>
        </form>
      </CardContent>
      </Card>
    </div>
  </SectionContainer>
</Section>
