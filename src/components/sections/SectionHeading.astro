---
/*
  One section header, used by every band on the marketing site.

  Before this, each section invented its own: different eyebrow treatments,
  three different heading sizes, descriptions at three different widths. That
  inconsistency is most of what separates a page that looks designed from one
  that looks assembled — a reader does not consciously notice the rhythm, but
  they notice its absence.

  The eyebrow is a pill rather than bare uppercase text: an outlined chip with
  a small brand dot, which is the reference design's most recognisable detail
  and gives every band a visible starting point.

  `align="start"` is for the alternating rows, `center` for full-width bands.
*/

export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'start' | 'center';
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'center',
  class: className = '',
} = Astro.props;

const centered = align === 'center';
---

<div
  class:list={[
    'flex flex-col',
    centered ? 'mx-auto max-w-2xl items-center text-center' : 'max-w-xl items-start',
    className,
  ]}
>
  {
    eyebrow && (
      <p class="eyebrow-pill text-muted-foreground">
        <span class="bg-brand size-1.5 rounded-full" aria-hidden="true" />
        {eyebrow}
      </p>
    )
  }
  <h2 class="text-section text-foreground mt-5 text-balance">{title}</h2>
  {
    description && (
      <p class="text-muted-foreground mt-4 max-w-xl text-base text-pretty sm:text-lg">
        {description}
      </p>
    )
  }
</div>
