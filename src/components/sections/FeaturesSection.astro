---
import { Section, SectionContainer } from '@/components/ui/section';
import { Icon } from '@/components/ui/icon';
import { Button } from '@/components/ui/button';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import type { FeaturesSectionProps as Props } from '@/models/marketing';

/*
  Replaces Fulldev's features-2, which is a flat 3-column grid of centred icons —
  every item weighted identically, so nothing leads. This is a bento: the two
  things that actually sell the product (the branded PDF, and that it is
  generated on-device) get the large tiles, the rest fill in around them.
*/

const { class: className = '' } = Astro.props;

const supporting = [
  {
    icon: 'calculator',
    title: 'TVSH dhe zbritje',
    body: 'TVSH 20%, 6% ose 0% dhe zbritje në vlerë — totalet llogariten vetë.',
  },
  {
    icon: 'share-2',
    title: 'Dërgo në WhatsApp',
    body: 'Shkarko ose ndaje direkt nga telefoni — WhatsApp, Viber, email.',
  },
  {
    icon: 'crop',
    title: 'Logo pa programe',
    body: 'Ngarko, preje dhe qendrizo logon direkt në shfletues. Pa Photoshop.',
  },
  {
    icon: 'lock',
    title: 'Vetëm ti i sheh',
    body: 'Çdo faturë e lidhur me llogarinë tënde, e ruajtur në serverë në BE.',
  },
];

/*
  Placement, in DOM order, on the 6-column / 4-row grid:
    row 1  lead (4 cols)  | ink (2 cols, rows 1-3)
    row 2  TVSH           | WhatsApp
    row 3  logo           | privatësia
    row 4  Excel (4 cols) | paid is final (2 cols)
  Saved clients used to sit here too, but the showcase above now covers them in
  depth with real UI — repeating it made the page say the same thing twice.
*/

/* The Excel tile's miniature: a customer's own headers landing in ours. */
const columnMatches = [
  { theirs: 'Nr. Fature', ours: 'Numri' },
  { theirs: 'Blerësi', ours: 'Klienti' },
  { theirs: 'Shuma', ours: 'Vlera' },
];
---

<Section id="vecorite" class={`bg-ground ${className}`}>
  <SectionContainer data-reveal>
    <SectionHeading
      eyebrow="Veçoritë"
      title="Gjithçka që i duhet një biznesi të vogël"
      description="Asgjë më shumë. Pa module kontabiliteti që nuk i hap kurrë."
    />
  </SectionContainer>

  <SectionContainer class="max-w-6xl">
    <div class="grid gap-4 md:grid-cols-6 md:grid-rows-4" data-stagger>
      <!-- Lead tile: the branded PDF -->
      <article
        class="bg-card shadow-card group relative overflow-hidden rounded-2xl p-7 md:col-span-4 md:row-span-1"
      >
        <div class="relative flex flex-col gap-4 md:flex-row md:items-start md:gap-7">
          <div class="flex-1">
            <div
              class="bg-ink flex size-11 items-center justify-center rounded-xl transition-transform group-hover:scale-105"
            >
              <Icon name="badge-check" class="text-brand size-5" />
            </div>
            <h3 class="mt-5 text-lg font-semibold tracking-tight">
              NIPT-i dhe logo, gjithmonë aty
            </h3>
            <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
              Vendos një herë të dhënat e biznesit — NIPT, adresë, telefon, logo — dhe
              dalin automatikisht në krye të çdo fature.
            </p>
          </div>

          <!-- Miniature of the printed header -->
          <div
            class="ring-border w-full shrink-0 rounded-xl bg-white p-3 ring-1 md:w-52"
            aria-hidden="true"
          >
            <div class="flex items-start justify-between">
              <div>
                <div
                  class="bg-ink text-brand flex size-6 items-center justify-center rounded text-[9px] font-bold"
                >
                  BK
                </div>
                <p class="text-ink mt-1.5 text-[9px] font-bold">Bar Kafe Vlora</p>
                <p class="text-[8px] text-slate/60">NIPT: L72119451K</p>
              </div>
              <p class="text-primary text-[11px] font-extrabold">FATURË</p>
            </div>
            <div class="bg-brand mt-2 h-0.5 w-8 rounded-full"></div>
            <div class="mt-2 space-y-1">
              <div class="bg-muted h-1.5 w-full rounded-full"></div>
              <div class="bg-muted h-1.5 w-4/5 rounded-full"></div>
              <div class="bg-muted h-1.5 w-3/5 rounded-full"></div>
            </div>
          </div>
        </div>
      </article>

      <!-- Lead tile: on-device generation, dark for emphasis -->
      <article
        class="bg-ink text-mist group relative overflow-hidden rounded-2xl p-7 md:col-span-2 md:row-span-3"
      >
        <div
          class="bg-brand/20 pointer-events-none absolute -top-24 -right-24 size-56 rounded-full blur-3xl"
          aria-hidden="true"
        >
        </div>

        <!-- Centred: without the stat row the copy would sit against the top of
             a three-row tile with a large void beneath it. -->
        <div class="relative flex h-full flex-col justify-center">
          <div
            class="bg-brand/15 flex size-11 items-center justify-center rounded-xl transition-transform group-hover:scale-105"
          >
            <Icon name="download" class="text-brand size-5" />
          </div>

          <h3 class="mt-5 text-lg font-semibold tracking-tight">PDF në 2 minuta</h3>
          <p class="text-mist/70 mt-2 text-sm leading-relaxed">
            Zgjidh klientin, shto artikujt, shtyp Shkarko. Fatura gjenerohet në telefonin
            tënd — pa pritje, pa server.
          </p>
        </div>
      </article>

      <!-- Supporting tiles -->
      {
        supporting.map((feature) => (
          <article class="bg-card shadow-card group lift rounded-2xl p-6 md:col-span-2">
            <div class="bg-accent ring-primary/10 flex size-11 items-center justify-center rounded-xl ring-1 transition-transform group-hover:scale-105">
              <Icon name={feature.icon} class="text-primary size-5" />
            </div>
            <h3 class="mt-5 font-semibold tracking-tight">{feature.title}</h3>
            <p class="text-muted-foreground mt-1.5 text-sm leading-relaxed">
              {feature.body}
            </p>
          </article>
        ))
      }

      <!-- Excel: the way in for a business that already keeps its invoices in a sheet -->
      <article class="bg-card shadow-card group rounded-2xl p-7 md:col-span-4">
        <div class="flex flex-col gap-5 md:flex-row md:items-center md:gap-7">
          <div class="flex-1">
            <div
              class="bg-accent ring-primary/10 flex size-11 items-center justify-center rounded-xl ring-1 transition-transform group-hover:scale-105"
            >
              <Icon name="file-spreadsheet" class="text-primary size-5" />
            </div>
            <h3 class="mt-5 text-lg font-semibold tracking-tight">
              Sill faturat e vjetra nga Excel
            </h3>
            <p class="text-muted-foreground mt-2 text-sm leading-relaxed">
              Ke një Excel që e mban prej vitesh? Ngarkoje ashtu siç është. Na trego një
              herë çfarë ka në secilën kolonë dhe herën tjetër e dimë vetë. Kur ta kërkojë
              kontabilisti, e nxjerr çdo faturë në Excel.
            </p>
          </div>

          <!-- Miniature of the column matching -->
          <div
            class="ring-border w-full shrink-0 rounded-xl bg-white p-3 ring-1 md:w-60"
            aria-hidden="true"
          >
            <p class="text-[9px] font-semibold tracking-wider text-slate/60 uppercase">
              Përputh kolonat
            </p>
            <ul class="mt-2 space-y-1.5">
              {
                columnMatches.map((m) => (
                  <li class="flex items-center gap-1.5 text-[10px]">
                    <span class="bg-muted text-ink flex-1 truncate rounded px-1.5 py-1">
                      {m.theirs}
                    </span>
                    <Icon name="arrow-right" class="text-primary size-3 shrink-0" />
                    <span class="bg-accent text-primary flex-1 truncate rounded px-1.5 py-1 font-semibold">
                      {m.ours}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </article>

      <!-- Paid is final -->
      <article class="bg-card shadow-card group lift rounded-2xl p-6 md:col-span-2">
        <div
          class="bg-accent ring-primary/10 flex size-11 items-center justify-center rounded-xl ring-1 transition-transform group-hover:scale-105"
        >
          <Icon name="shield-check" class="text-primary size-5" />
        </div>
        <h3 class="mt-5 font-semibold tracking-tight">E paguar, e mbyllur</h3>
        <p class="text-muted-foreground mt-1.5 text-sm leading-relaxed">
          Një faturë e paguar nuk ndryshohet e nuk fshihet më — historiku yt mbetet ashtu
          siç ndodhi.
        </p>
      </article>
    </div>

    <div class="flex justify-center">
      <Button
        as="a"
        href="/regjistrohu"
        size="lg"
        class="press rounded-full px-6"
        data-auth-show="anon"
      >
        Fillo falas
      </Button>
      <Button
        as="a"
        href="/app"
        size="lg"
        class="press rounded-full px-6"
        data-auth-show="user"
      >
        Shko te paneli
      </Button>
    </div>
  </SectionContainer>
</Section>
