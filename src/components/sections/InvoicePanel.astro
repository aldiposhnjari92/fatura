---
import { formatALL } from '@/lib/utils';

/*
  The product shot, built in markup.

  It mirrors what src/lib/pdf.ts actually draws — same teal rule under the
  header, same column order, same emphasis on TOTALI — so the page is showing
  the real output rather than a flattering illustration of it. Figures below are
  a coherent worked example: the line items sum to the subtotal, VAT is 20% of
  that, and the total is their sum. Nothing here should be a number a customer
  could catch us inventing.
*/

const items = [
  { description: 'Punime instalimi elektrik', qty: 12, price: 2500 },
  { description: 'Materiale dhe kabllo', qty: 1, price: 18000 },
  { description: 'Mirëmbajtje mujore', qty: 2, price: 6000 },
];

const subtotal = items.reduce((sum, item) => sum + item.qty * item.price, 0);
const vat = Math.round(subtotal * 0.2);
const total = subtotal + vat;
---

<div class="relative">
  <!-- Depth: a second sheet peeking out behind, as a stack of paperwork would. -->
  <div
    class="bg-card ring-border/60 absolute -top-3 -left-3 h-full w-full rounded-2xl ring-1 sm:-top-4 sm:-left-4"
    aria-hidden="true"
  >
  </div>

  <article
    class="bg-card ring-border/70 relative rounded-2xl p-6 shadow-2xl ring-1 sm:p-8"
    aria-label="Shembull fature e krijuar me Fatura.co"
  >
    <!-- Document header -->
    <header class="flex items-start justify-between gap-6">
      <div class="flex items-start gap-3">
        <span
          class="bg-ink text-brand flex size-10 shrink-0 items-center justify-center rounded-lg text-xs font-bold"
        >
          BK
        </span>
        <div class="min-w-0">
          <p class="text-foreground text-sm font-bold">Bar Kafe Vlora</p>
          <p class="text-muted-foreground text-[11px]">NIPT: L72119451K</p>
          <p class="text-muted-foreground text-[11px]">Rr. Jakov Xoxa, Fier</p>
        </div>
      </div>

      <div class="shrink-0 text-right">
        <p class="text-primary text-sm font-extrabold tracking-[0.12em]">FATURË</p>
        <p class="text-muted-foreground mt-1 text-[11px]">FAT-2026-014</p>
        <p class="text-muted-foreground text-[11px]">16.08.2026</p>
      </div>
    </header>

    <div class="bg-brand mt-4 h-0.5 w-12 rounded-full" aria-hidden="true"></div>

    <!-- Bill to -->
    <div class="mt-5">
      <p class="text-muted-foreground text-[10px] font-semibold tracking-[0.14em] uppercase">
        Faturuar për
      </p>
      <p class="text-foreground mt-1 text-sm font-semibold">Alba Construction sh.p.k.</p>
      <p class="text-muted-foreground text-[11px]">NIPT: K81430022M</p>
    </div>

    <!-- Items -->
    <div class="mt-6 overflow-hidden rounded-lg border">
      <div
        class="text-muted-foreground bg-muted/50 grid grid-cols-[1fr_auto_auto] gap-4 border-b px-3 py-2 text-[10px] font-semibold tracking-wide uppercase"
      >
        <span>Përshkrimi</span>
        <span class="text-right">Sasia</span>
        <span class="w-20 text-right">Vlera</span>
      </div>
      {
        items.map((item) => (
          <div class="grid grid-cols-[1fr_auto_auto] gap-4 border-b px-3 py-2.5 text-xs last:border-0">
            <span class="text-foreground/90 truncate">{item.description}</span>
            <span class="text-muted-foreground text-right tabular-nums">{item.qty}</span>
            <span class="text-foreground w-20 text-right font-medium tabular-nums">
              {formatALL(item.qty * item.price, false)}
            </span>
          </div>
        ))
      }
    </div>

    <!-- Totals -->
    <dl class="mt-4 ml-auto flex max-w-[15rem] flex-col gap-1.5 text-xs">
      <div class="flex justify-between gap-6">
        <dt class="text-muted-foreground">Nëntotali</dt>
        <dd class="tabular-nums">{formatALL(subtotal, false)}</dd>
      </div>
      <div class="flex justify-between gap-6">
        <dt class="text-muted-foreground">TVSH 20%</dt>
        <dd class="tabular-nums">{formatALL(vat, false)}</dd>
      </div>
      <div class="mt-1 flex justify-between gap-6 border-t pt-2">
        <dt class="font-bold">TOTALI</dt>
        <dd class="text-primary text-sm font-extrabold tabular-nums">
          {formatALL(total)}
        </dd>
      </div>
    </dl>
  </article>

  <!-- Floating chips: the two moments that sell the product — it took seconds,
       and the money actually arrived. -->
  <div
    class="bg-ink text-mist ring-brand/25 absolute -bottom-5 -left-3 flex items-center gap-2.5 rounded-xl px-3.5 py-2.5 shadow-xl ring-1 sm:-left-6"
  >
    <span class="bg-brand/20 text-brand flex size-7 shrink-0 items-center justify-center rounded-lg">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-3.5"
        ><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path></svg
      >
    </span>
    <div class="leading-tight">
      <p class="text-[11px] font-semibold">PDF u shkarkua</p>
      <p class="text-mist/50 text-[10px]">në 1.4 sekonda</p>
    </div>
  </div>

  <div
    class="bg-card ring-border absolute -top-3 -right-3 hidden items-center gap-2 rounded-full px-3 py-1.5 shadow-lg ring-1 sm:flex"
  >
    <span class="size-1.5 rounded-full bg-teal-500" aria-hidden="true"></span>
    <span class="text-[11px] font-semibold">E paguar</span>
  </div>
</div>
