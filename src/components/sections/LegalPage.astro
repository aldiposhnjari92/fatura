---
import { Section, SectionContainer } from '@/components/ui/section';
import { Typography } from '@/components/ui/typography';

export interface Props {
  heading: string;
  updated: string;
}

const { heading, updated } = Astro.props;
---

<!--
  Legal pages get the same masthead treatment as the rest of the site: an
  eyebrow, the display face, and a rule that closes the header. Previously they
  were a bare h1 on white, which made them feel like a different website.
-->
<div class="border-b">
  <div class="container py-14 sm:py-20">
    <div class="mx-auto max-w-3xl">
      <p class="text-primary text-xs font-bold tracking-[0.16em] uppercase">
        Dokument ligjor
      </p>
      <h1 class="text-section text-foreground mt-4 text-balance">{heading}</h1>
      <p class="text-muted-foreground mt-4 text-sm">Përditësuar më {updated}</p>
    </div>
  </div>
</div>

<Section>
  <SectionContainer class="max-w-3xl gap-6">

    <!-- Typography styles the raw h2/p/ul/a inside this slot. -->
    <Typography as="article" class="flex flex-col gap-4">
      <slot />
    </Typography>
  </SectionContainer>
</Section>
