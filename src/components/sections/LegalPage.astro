---
import { Section, SectionContainer } from '@/components/ui/section';
import { Typography } from '@/components/ui/typography';

export interface Props {
  heading: string;
  updated: string;
}

const { heading, updated } = Astro.props;
---

<Section>
  <SectionContainer class="max-w-3xl gap-6">
    <div class="flex flex-col gap-2">
      <h1 class="text-foreground text-3xl font-semibold tracking-tight sm:text-4xl">
        {heading}
      </h1>
      <p class="text-muted-foreground text-sm">Përditësuar më {updated}</p>
    </div>

    <!-- Typography styles the raw h2/p/ul/a inside this slot. -->
    <Typography as="article" class="flex flex-col gap-4">
      <slot />
    </Typography>
  </SectionContainer>
</Section>
