---
import { Section, SectionContainer } from '@/components/ui/section';
import SectionHeading from '@/components/sections/SectionHeading.astro';
import { Button } from '@/components/ui/button';

const steps = [
  {
    n: '01',
    title: 'Krijo llogarinë',
    body: 'Email dhe fjalëkalim. Pastaj plotëso një herë emrin e biznesit, NIPT-in dhe ngarko logon.',
  },
  {
    n: '02',
    title: 'Shto faturën',
    body: 'Zgjidh klientin, shkruaj artikujt me sasi dhe çmim. Nëntotali, TVSH-ja dhe totali dalin vetë.',
  },
  {
    n: '03',
    title: 'Shkarko PDF-në',
    body: 'Një klik dhe fatura e markuar me logon tënde shkarkohet. Dërgoje me WhatsApp ose email.',
  },
];
---

<Section id="si-funksionon">
  <SectionContainer data-reveal>
    <SectionHeading
      eyebrow="Si funksionon"
      title="Tri hapa. Kaq."
      description="Nga regjistrimi te fatura e parë e shkarkuar — më pak se 5 minuta."
    />
  </SectionContainer>

  <SectionContainer class="max-w-6xl">
    {/*
      Each step carries the piece of interface it actually describes, the way
      the showcase rows above do. A numbered rail with three paragraphs told the
      reader what happens; showing the screen proves it.
    */}
    <ol class="grid gap-6 md:grid-cols-3" data-stagger>
      {
        steps.map((step) => (
          <li class="bg-card shadow-card lift flex flex-col rounded-2xl p-6">
            {/* The reference design labels each card "Step 1 / 2 / 3" above the
                title rather than badging it beside — the label reads as an
                ordinal, the title stays the heading. */}
            <span class="text-primary text-[11px] font-bold tracking-[0.14em] uppercase">
              Hapi {Number(step.n)}
            </span>
            <h3 class="mt-2 text-base font-semibold tracking-tight">{step.title}</h3>

            <p class="text-muted-foreground mt-3 text-sm leading-relaxed text-pretty">
              {step.body}
            </p>

            <div class="bg-muted/40 mt-6 rounded-xl border p-3">
              {step.n === '01' && (
                <div class="flex flex-col gap-2">
                  <span class="text-muted-foreground text-[10px] font-semibold uppercase">
                    Email
                  </span>
                  <div class="bg-background flex h-8 items-center rounded-md border px-2.5 text-[11px]">
                    biznesi@shembull.al
                  </div>
                  <span class="text-muted-foreground mt-1 text-[10px] font-semibold uppercase">
                    Emri i biznesit
                  </span>
                  <div class="bg-background flex h-8 items-center rounded-md border px-2.5 text-[11px]">
                    Bar Kafe Vlora
                  </div>
                </div>
              )}

              {step.n === '02' && (
                <div class="flex flex-col gap-1.5">
                  <div class="text-muted-foreground grid grid-cols-[1fr_auto_auto] gap-2 text-[9px] font-semibold uppercase">
                    <span>Përshkrimi</span>
                    <span class="w-6 text-right">Sasi</span>
                    <span class="w-12 text-right">Vlera</span>
                  </div>
                  {[
                    ['Punime instalimi', '12', '30 000'],
                    ['Materiale', '1', '18 000'],
                  ].map((row) => (
                    <div class="bg-background grid grid-cols-[1fr_auto_auto] gap-2 rounded-md border px-2 py-1.5 text-[11px]">
                      <span class="truncate">{row[0]}</span>
                      <span class="text-muted-foreground w-6 text-right tabular-nums">
                        {row[1]}
                      </span>
                      <span class="w-12 text-right font-medium tabular-nums">{row[2]}</span>
                    </div>
                  ))}
                  <div class="mt-1 flex items-center justify-between border-t pt-1.5 text-[11px]">
                    <span class="font-bold">TOTALI</span>
                    <span class="text-primary font-extrabold tabular-nums">57 600 Lekë</span>
                  </div>
                </div>
              )}

              {step.n === '03' && (
                <div class="flex items-center gap-3">
                  <div class="bg-background ring-border relative flex h-16 w-12 shrink-0 flex-col gap-1 rounded-md p-1.5 shadow-sm ring-1">
                    <div class="bg-brand h-0.5 w-4 rounded-full" />
                    <div class="bg-muted h-1 w-full rounded-full" />
                    <div class="bg-muted h-1 w-4/5 rounded-full" />
                    <div class="bg-muted h-1 w-3/5 rounded-full" />
                    <div class="bg-primary/70 mt-auto h-1 w-2/3 self-end rounded-full" />
                  </div>
                  <div class="min-w-0">
                    <p class="text-[11px] font-semibold">FAT-2026-014.pdf</p>
                    <p class="text-muted-foreground text-[10px]">Gati për WhatsApp</p>
                    <span class="bg-accent text-primary mt-1.5 inline-block rounded-full px-2 py-0.5 text-[9px] font-bold">
                      U shkarkua
                    </span>
                  </div>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 flex justify-center">
      <Button
        as="a"
        href="/regjistrohu"
        size="lg"
        class="press rounded-full px-6"
      >
        Provo tani — falas
      </Button>
    </div>
  </SectionContainer>
</Section>
