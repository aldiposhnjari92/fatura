---
import { Icon } from '@/components/ui/icon';

/*
  The band directly under the hero, where an established SaaS puts a customer
  logo wall or a G2 badge.

  Fatura.co has no customers to name yet, and inventing logos or testimonials
  would be a lie printed on the front page of a product whose entire pitch is
  that it is trustworthy with your business data. So this states three things
  that are true today and that a small business actually worries about: where
  the data lives, that the document never leaves the device, and that starting
  costs nothing.

  It is a single quiet strip rather than three cards: the hero above and the
  steps below are both card-heavy, and this band's job is to be read in one
  glance on the way past.
*/

const signals = [
  {
    icon: 'shield-check',
    title: 'Të dhënat në BE',
    body: 'Të enkriptuara, vetëm ti ke akses',
  },
  {
    icon: 'smartphone',
    title: 'PDF në pajisjen tënde',
    body: 'Nuk shkon te asnjë server i tretë',
  },
  {
    icon: 'credit-card',
    title: 'Nis pa kartë',
    body: '5 fatura në muaj falas, përgjithmonë',
  },
];
---

<section class="border-y bg-card/60" aria-label="Pse të besosh Fatura.co">
  <div class="container">
    <ul class="grid divide-y sm:grid-cols-3 sm:divide-x sm:divide-y-0" data-stagger>
      {
        signals.map((signal) => (
          <li class="flex items-center gap-4 py-6 sm:justify-center sm:px-6">
            <span class="bg-accent text-primary flex size-11 shrink-0 items-center justify-center rounded-2xl">
              <Icon name={signal.icon} class="size-5" />
            </span>
            <div class="min-w-0">
              <h3 class="text-sm font-semibold tracking-tight">{signal.title}</h3>
              <p class="text-muted-foreground mt-0.5 text-sm text-pretty">{signal.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
