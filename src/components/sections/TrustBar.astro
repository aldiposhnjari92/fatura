---
import { Icon } from '@/components/ui/icon';

/*
  The band directly under the hero, where an established SaaS puts a customer
  logo wall or a G2 badge.

  Fatura.co has no customers to name yet, and inventing logos or testimonials
  would be a lie printed on the front page of a product whose entire pitch is
  that it is trustworthy with your business data. So this states three things
  that are true today and that a small business actually worries about: where
  the data lives, that the document never leaves the device, and that starting
  costs nothing.

  When there are real customers, this is the slot that becomes the logo wall —
  which is what the reference design puts here, in the same band.
*/

const signals = [
  {
    icon: 'shield-check',
    title: 'Të dhënat në BE',
    body: 'Ruajtura të enkriptuara. Vetëm ti ke akses te faturat e tua.',
  },
  {
    icon: 'smartphone',
    title: 'PDF në pajisjen tënde',
    body: 'Fatura krijohet në telefon. Nuk shkon te asnjë server i tretë.',
  },
  {
    icon: 'credit-card',
    title: 'Nis pa kartë',
    body: '5 fatura në muaj falas, përgjithmonë. Pa kontratë.',
  },
];
---

<section class="bg-ground border-y" aria-label="Pse të besosh Fatura.co">
  <div class="container py-14 sm:py-16">
    <p class="text-muted-foreground text-center text-sm">
      Ndërtuar mbi tri premtime që i mbajmë nga dita e parë
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {
        signals.map((signal) => (
          <div class="bg-card shadow-card rounded-2xl p-6">
            <div class="bg-accent text-primary flex size-10 items-center justify-center rounded-full">
              <Icon name={signal.icon} class="size-5" />
            </div>
            <h3 class="mt-4 text-sm font-semibold tracking-tight">{signal.title}</h3>
            <p class="text-muted-foreground mt-1.5 text-sm leading-relaxed text-pretty">
              {signal.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
