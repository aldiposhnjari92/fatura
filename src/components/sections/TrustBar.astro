---
import { Icon } from '@/components/ui/icon';

/*
  The band directly under the hero, where an established SaaS puts a customer
  logo wall or a G2 badge.

  Fatura.co has no customers to name yet, and inventing logos or testimonials
  would be a lie printed on the front page of a product whose entire pitch is
  that it is trustworthy with your business data. So this states four things
  that are true today and that a small business actually worries about: where
  the product is from, where the data lives, that the document never leaves the
  device, and that starting costs nothing.

  When there are real customers, this is the slot that becomes the logo wall.
*/

const signals = [
  {
    icon: 'map-pin',
    title: 'Bërë në Shqipëri',
    body: 'Ndërtuar në Fier, për mënyrën si faturon një biznes shqiptar.',
  },
  {
    icon: 'shield-check',
    title: 'Të dhënat në BE',
    body: 'Ruajtura të enkriptuara. Vetëm ti ke akses te faturat e tua.',
  },
  {
    icon: 'smartphone',
    title: 'PDF në pajisjen tënde',
    body: 'Fatura krijohet në telefon. Nuk shkon te asnjë server i tretë.',
  },
  {
    icon: 'credit-card',
    title: 'Nis pa kartë',
    body: '5 fatura në muaj falas, përgjithmonë. Pa kontratë.',
  },
];
---

<section class="border-y" aria-label="Pse të besosh Fatura.co">
  <div class="container">
    <div class="grid gap-px sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {
        signals.map((signal) => (
          <div class="group relative py-8 lg:px-7 lg:first:pl-0 lg:last:pr-0">
            {/* Hairline between columns, only where columns actually sit side by side. */}
            <span
              class="bg-border absolute top-8 bottom-8 -left-px hidden w-px lg:block lg:group-first:hidden"
              aria-hidden="true"
            />
            <Icon name={signal.icon} class="text-primary size-5" />
            <h3 class="mt-3.5 text-sm font-semibold tracking-tight">{signal.title}</h3>
            <p class="text-muted-foreground mt-1.5 text-sm leading-relaxed text-pretty">
              {signal.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
