---
import {
  STATUS_BADGE_BASE,
  STATUS_META,
  toInvoiceStatus,
  type InvoiceStatus,
} from '@/lib/types';
import { useTranslations } from '@/lib/i18n';
import { cn } from '@/lib/utils';

export interface Props {
  status: InvoiceStatus;
  class?: string;
}

const { status, class: className } = Astro.props;

/* The fallback lives in toInvoiceStatus() — see the note there. */
const known = toInvoiceStatus(status);

const t = useTranslations();
---

<span data-slot="status-badge" class={cn(STATUS_BADGE_BASE, STATUS_META[known].className, className)}>
  {t(`status.${known}`)}
</span>
