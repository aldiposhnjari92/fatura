---
import { STATUS_BADGE_BASE, STATUS_META, type InvoiceStatus } from '@/lib/types';
import { useTranslations } from '@/lib/i18n';
import { cn } from '@/lib/utils';

export interface Props {
  status: InvoiceStatus;
  class?: string;
}

const { status, class: className } = Astro.props;

/*
  `status` comes from the database, so the fallback is not dead code: a value
  the column grows later would otherwise render an unstyled, unlabelled chip
  rather than an honest "Draft". The label falls back with it, so the colour
  and the wording can never disagree.
*/
const known = status in STATUS_META ? status : 'draft';

const t = useTranslations();
---

<span data-slot="status-badge" class={cn(STATUS_BADGE_BASE, STATUS_META[known].className, className)}>
  {t(`status.${known}`)}
</span>
