---
export interface Props {
  class?: string;
  /** Use on dark surfaces (hero, footer) where the wordmark must read light. */
  invert?: boolean;
}
const { class: className = '', invert = false } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg
    width="30"
    height="30"
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    class="shrink-0"
  >
    <rect width="32" height="32" rx="8.5" fill={invert ? '#00ADB5' : '#222831'} />
    <path
      d="M10 9.5h12M10 15.5h8M10 21.5h5"
      stroke={invert ? '#222831' : '#00ADB5'}
      stroke-width="2.6"
      stroke-linecap="round"
    />
  </svg>
  <span
    class={`text-[1.0625rem] font-bold tracking-[-0.02em] ${
      invert ? 'text-mist' : 'text-foreground'
    }`}
  >
    Fatura<span class={invert ? 'text-brand' : 'text-primary'}>.co</span>
  </span>
</span>
