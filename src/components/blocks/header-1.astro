---
import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import { Header, HeaderContainer, HeaderGroup } from "@/components/ui/header"
import { Icon } from "@/components/ui/icon"
import { Logo, LogoImage, LogoText } from "@/components/ui/logo"
import {
  NavigationMenu,
  NavigationMenuItem,
  NavigationMenuLink,
  NavigationMenuList,
} from "@/components/ui/navigation-menu"
import {
  Sheet,
  SheetClose,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
  SheetTrigger,
} from "@/components/ui/sheet"

type Props = {
  class?: string
  logo: {
    label: string
    href: string
    src?: any
    srcLight?: any
    srcDark?: any
    alt?: string
  }
  navigation: {
    label: string
    href: string
    active?: boolean
    links?: {
      label: string
      href: string
    }[]
  }[]
  buttons: {
    label: string
    href: string
    icon?: string
    variant?: "default" | "outline" | "secondary" | "ghost"
    /** Show this button only to signed-out ('anon') or signed-in ('user') visitors. */
    'data-auth-show'?: 'anon' | 'user'
  }[]
}

const { class: className, logo, navigation, buttons } = Astro.props
---

<Header class={cn("py-4 sm:py-5", className)}>
  <HeaderContainer class="items-center justify-between gap-6">
    <HeaderGroup>
      <Logo href={logo.href}>
        <LogoImage
          src={logo.src}
          srcLight={logo.srcLight}
          srcDark={logo.srcDark}
          alt={logo.alt}
        />
        {logo.label && <LogoText>{logo.label}</LogoText>}
      </Logo>
    </HeaderGroup>
    <NavigationMenu class="hidden flex-none justify-start lg:flex">
      <NavigationMenuList class="justify-start gap-2">
        {
          navigation.map((item, index) => (
            <NavigationMenuItem value={`nav-${index}`}>
              <NavigationMenuLink href={item.href} active={item.active} class="px-3 py-2.5">
                {item.label}
              </NavigationMenuLink>
            </NavigationMenuItem>
          ))
        }
      </NavigationMenuList>
    </NavigationMenu>
    <HeaderGroup class="ml-auto hidden flex-1 justify-end gap-3 lg:flex">
      <slot />
      {
        buttons.map(({ label, icon, ...button }) => (
          <Button
            as="a"
            size={icon && !label ? "icon-sm" : "sm"}
            aria-label={label}
            target={button.href.startsWith("http") ? "_blank" : undefined}
            rel={button.href.startsWith("http") ? "noreferrer" : undefined}
            {...button}
          >
            {icon && <Icon name={icon} />}
            {label}
          </Button>
        ))
      }
    </HeaderGroup>
    <Sheet class="lg:hidden">
      <SheetTrigger
        variant="ghost"
        size="icon-sm"
        class="ml-auto"
        aria-label="Open menu"
      >
        <Icon name="menu" />
      </SheetTrigger>
      <SheetContent side="right" class="p-0">
        <SheetHeader class="sr-only">
          <SheetTitle>Menu</SheetTitle>
          <SheetDescription>Site navigation and actions.</SheetDescription>
        </SheetHeader>
        <div class="flex h-full flex-col gap-6 px-4 py-12">
          <nav aria-label="Main navigation" class="flex flex-col gap-1">
            {/*
              These were rendering the label with no href at all — every item in
              the mobile menu was an inert button.

              Button carries `data-slot="dialog-close"` directly (which is all
              SheetClose does) because SheetClose's prop type does not carry the
              polymorphic `as`/`href`. Same behaviour, correct types: a real
              anchor that also dismisses the sheet on tap.
            */}
            {
              navigation.map((item) => (
                <>
                  <Button
                    data-slot="dialog-close"
                    as="a"
                    href={item.href}
                    variant="ghost"
                    class="justify-start"
                    aria-current={item.active ? 'page' : undefined}
                  >
                    {item.label}
                  </Button>

                  {item.links?.map((link) => (
                    <Button
                      data-slot="dialog-close"
                      as="a"
                      href={link.href}
                      variant="ghost"
                      class="text-muted-foreground justify-start pl-6 text-sm"
                    >
                      {link.label}
                    </Button>
                  ))}
                </>
              ))
            }
          </nav>
          <div class="mt-auto flex flex-col gap-2">
            <slot />
            {/*
              The action buttons were desktop-only, so on mobile the sheet had
              no way in at all. Same `buttons` array, rendered full-width and
              dismissing the sheet on tap; `data-auth-show` rides along in the
              spread so the anon/user swap still works here.
            */}
            {
              buttons.map(({ label, icon, variant, ...button }) => (
                <Button
                  data-slot="dialog-close"
                  as="a"
                  size="lg"
                  variant={variant === "ghost" ? "outline" : variant}
                  class="w-full"
                  aria-label={label}
                  target={button.href.startsWith("http") ? "_blank" : undefined}
                  rel={button.href.startsWith("http") ? "noreferrer" : undefined}
                  {...button}
                >
                  {icon && <Icon name={icon} />}
                  {label}
                </Button>
              ))
            }
          </div>
        </div>
      </SheetContent>
    </Sheet>
  </HeaderContainer>
</Header>
