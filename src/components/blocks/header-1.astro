---
import { cn } from "@/lib/utils"
import { Button } from "@/components/ui/button"
import { Icon } from "@/components/ui/icon"
import Logo from "@/components/Logo.astro"
import type { Header1Props as Props } from '@/models/marketing';

/*
  The floating pill header.

  Desktop: logo, the section links as chips in the middle, and the actions on
  the right, all inside one rounded glass bar. The chip for the current page —
  or, on the home page, the section in view (see the scroll-spy in
  MarketingLayout) — is filled, so a visitor always knows where they are.

  Mobile: the same bar with a single menu toggle. The menu drops down as a card
  under the pill instead of sliding a full-height sheet in from the side: the
  links stay next to the thumb, each carries an icon and one line saying what
  is behind it, and the page underneath stays visible for context.
*/

const { class: className, logo, navigation, buttons } = Astro.props
---

<header data-slot="site-header" class={cn("px-3 pt-3 sm:px-4 sm:pt-4", className)}>
  <div
    data-slot="site-header-bar"
    class="border-border/70 mx-auto flex max-w-6xl items-center gap-3 rounded-full border py-2 pr-2 pl-4 sm:pl-5"
  >
    <a href={logo.href} class="shrink-0" aria-label={logo.label}>
      <Logo />
    </a>

    <nav aria-label="Navigimi kryesor" class="mx-auto hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          navigation.map((item) => (
            <li>
              <a
                data-slot="site-nav-link"
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                class="text-foreground/75 hover:text-foreground hover:bg-muted rounded-full px-4 py-2 text-sm font-medium"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto hidden items-center gap-2 lg:ml-0 lg:flex">
      {
        buttons.map(({ label, icon, variant, ...button }) => (
          <Button
            as="a"
            size="sm"
            variant={variant}
            class={cn("press rounded-full px-4", variant !== "ghost" && "shadow-sm")}
            {...button}
          >
            {icon && <Icon name={icon} />}
            {label}
          </Button>
        ))
      }
    </div>

    <button
      type="button"
      data-slot="site-menu-toggle"
      class="hover:bg-muted ml-auto flex size-10 items-center justify-center rounded-full lg:hidden"
      aria-controls="site-menu"
      aria-expanded="false"
      aria-label="Hap menunë"
    >
      <Icon name="menu" class="size-5" data-icon="open" />
      <Icon name="x" class="hidden size-5" data-icon="close" />
    </button>
  </div>

  <div
    id="site-menu"
    data-slot="site-menu"
    class="bg-card border-border/70 mx-auto mt-2 max-w-6xl origin-top rounded-3xl border p-2 shadow-xl lg:hidden"
    hidden
  >
    <nav aria-label="Navigimi kryesor">
      <ul class="flex flex-col">
        {
          navigation.map((item) => (
            <li>
              <a
                data-slot="site-nav-link"
                href={item.href}
                aria-current={item.active ? "page" : undefined}
                class="hover:bg-muted flex items-center gap-3.5 rounded-2xl p-3"
              >
                {item.icon && (
                  <span class="bg-accent text-primary flex size-10 shrink-0 items-center justify-center rounded-xl">
                    <Icon name={item.icon} class="size-[1.125rem]" />
                  </span>
                )}
                <span class="min-w-0">
                  <span class="block text-sm font-semibold">{item.label}</span>
                  {item.description && (
                    <span class="text-muted-foreground block truncate text-xs">
                      {item.description}
                    </span>
                  )}
                </span>
                <Icon name="chevron-right" class="text-muted-foreground ml-auto size-4 shrink-0" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="mt-2 grid gap-2 border-t p-2 pt-4 sm:grid-cols-2">
      {
        buttons.map(({ label, icon, variant, ...button }) => (
          <Button
            as="a"
            size="lg"
            variant={variant === "ghost" ? "outline" : variant}
            class="w-full rounded-full"
            {...button}
          >
            {icon && <Icon name={icon} />}
            {label}
          </Button>
        ))
      }
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.querySelector('[data-slot="site-menu-toggle"]');
    var menu = document.getElementById('site-menu');
    if (!toggle || !menu) return;

    function set(open) {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Mbyll menunë' : 'Hap menunë');
      toggle.querySelector('[data-icon="open"]').classList.toggle('hidden', open);
      toggle.querySelector('[data-icon="close"]').classList.toggle('hidden', !open);
    }

    toggle.addEventListener('click', function () {
      set(menu.hidden);
    });

    // Any link in the menu — including a same-page #anchor, which would not
    // unload the page — closes it.
    menu.addEventListener('click', function (event) {
      if (event.target.closest('a')) set(false);
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && !menu.hidden) {
        set(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', function (event) {
      if (menu.hidden) return;
      if (menu.contains(event.target) || toggle.contains(event.target)) return;
      set(false);
    });

    // Rotating a phone to landscape can cross the lg breakpoint with the menu
    // open; the desktop bar has no toggle to close it from.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', function (mq) {
      if (mq.matches) set(false);
    });
  })();
</script>
