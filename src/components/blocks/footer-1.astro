---
import { cn } from "@/lib/utils"
import { Icon } from "@/components/ui/icon"
import Logo from "@/components/Logo.astro"
import { Section, SectionContainer } from "@/components/ui/section"

type Props = {
  class?: string
  brandName: string
  brandHref: string
  description: string
  socials?: {
    label: string
    href: string
    icon: string
  }[]
  columns: {
    title: string
    links: {
      label: string
      href: string
    }[]
  }[]
  copyright: string
  /** Sign-off shown opposite the legal line, e.g. "Bërë me dashuri". */
  signature?: string
}

const {
  class: className,
  brandName,
  brandHref,
  description,
  socials,
  columns,
  copyright,
  signature,
} = Astro.props
---

<footer class={cn("", className)}>
  {/*
    The page's last impression, so it gets the same care as the first: a brand
    column that says what this is and who it is for, link columns headed with
    the same eyebrow treatment used by every section above, and a bottom bar
    that separates the legal line from the navigation.
  */}
  <Section class="py-16 lg:py-24">
    <SectionContainer>
      <div class="grid gap-12 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,2fr)] lg:gap-16">
        <div class="flex flex-col gap-5">
          {/*
            The project's own logo, not Fulldev's LogoText — that one renders
            unstyled text which disappeared entirely against the ink footer.
            `invert` is the same variant the admin sidebar uses on dark.
          */}
          <a href={brandHref} class="w-fit" aria-label={brandName}>
            <Logo invert />
          </a>
          <p class="text-muted-foreground max-w-xs text-sm leading-relaxed text-pretty">
            {description}
          </p>

          <a
            href="mailto:aldiposhnjari@gmail.com"
            class="text-foreground hover:text-primary w-fit text-sm font-medium underline underline-offset-4"
          >
            aldiposhnjari@gmail.com
          </a>

          {
            socials && socials.length > 0 && (
              <div class="flex items-center gap-2">
                {socials.map((social) => (
                  <a
                    href={social.href}
                    class="text-muted-foreground hover:text-foreground hover:border-foreground/30 flex size-9 items-center justify-center rounded-lg border transition-colors"
                    aria-label={social.label}
                    target="_blank"
                    rel="noreferrer"
                  >
                    <Icon name={social.icon} class="size-4" />
                  </a>
                ))}
              </div>
            )
          }
        </div>

        <div class="grid gap-10 sm:grid-cols-3">
          {
            columns.map((column) => (
              <div class="flex flex-col gap-4">
                <p class="text-muted-foreground text-[11px] font-bold tracking-[0.14em] uppercase">
                  {column.title}
                </p>
                <ul class="flex flex-col gap-3">
                  {column.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="text-foreground/80 hover:text-foreground text-sm transition-colors"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      {/*
        Two lines, not one: the legal notice and the sign-off do different jobs,
        and running them together made the brand name appear twice in a row.
      */}
      <div
        class="mt-14 flex flex-col gap-2 border-t pt-6 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="text-muted-foreground text-sm">{copyright}</p>
        {signature && <p class="text-muted-foreground text-sm">{signature}</p>}
      </div>
    </SectionContainer>
  </Section>
</footer>
