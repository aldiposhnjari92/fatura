---
import { cn } from '@/lib/utils';
import { Button } from '@/components/ui/button';
import { Icon } from '@/components/ui/icon';
import { Price, PriceUnit, PriceValue } from '@/components/ui/price';
import { formatPriceValue } from '@/components/ui/price/format-price-value';
import { Section, SectionContainer } from '@/components/ui/section';
import SectionHeading from '@/components/sections/SectionHeading.astro';

/*
  Fulldev's stock pricing-2 renders every plan as a flat `border-none
  shadow-none` card, which reads as a spec sheet rather than an offer. This
  version keeps the same props (plus `featured`, `badge`, `note`) but gives the
  recommended plan real weight, the way the reference design does: the whole
  card filled with the brand colour, white type, a white button, and a lift
  above the plain cards on either side.

  Colour rule from the design system holds — the fill is `--brand-deep`, the
  deepened teal pinned to a fixed value, on which white measures 5.23:1. It is
  deliberately not `bg-primary`: the card sets `dark` on itself so the nested
  Fulldev primitives read light, and that flip would also raise `--primary`
  back to #00ADB5, where white falls to 2.75:1.
*/

type Props = {
  class?: string;
  /** BCP-47 tag for price formatting. sq-AL renders `currency: "ALL"` as "2000 Lekë". */
  locale?: string;
  title: string;
  description: string;
  plans: {
    name: string;
    description: string;
    price: number;
    compareAt?: number;
    currency: string;
    unit: string;
    features: string[];
    /** Renders the plan on ink with teal accents and lifts it above the rest. */
    featured?: boolean;
    /** Ribbon above the plan name, e.g. "Më i zgjedhuri". */
    badge?: string;
    /** Small reassurance under the button, e.g. "Pa kartë krediti". */
    note?: string;
    button: {
      label: string;
      href: string;
      variant?: 'default' | 'outline' | 'secondary' | 'ghost';
    };
    /**
     * Shown instead of `button` to visitors who are already signed in. Without
     * it an existing customer clicking "Fillo me Pro" hits /regjistrohu, which
     * the middleware bounces away from — landing them on the dashboard with
     * their plan choice discarded.
     */
    authedButton?: {
      label: string;
      href: string;
      variant?: 'default' | 'outline' | 'secondary' | 'ghost';
    };
  }[];
  /**
   * Billing terms on offer. With two or more, a switcher renders above the
   * grid and every priced plan shows the total for the selected term instead
   * of its monthly rate — so the number on the card is the amount actually
   * transferred, not one the visitor has to multiply in their head.
   */
  terms?: { months: number; label: string }[];
};

const {
  class: className,
  title,
  description,
  plans,
  terms = [],
  locale = 'sq-AL',
} = Astro.props;

const hasFeatured = plans.some((plan) => plan.featured);
const hasTerms = terms.length > 1;

/*
  The recommended plan takes the middle column.

  The centre of a three-up table is the position the eye lands on first, and
  the reference design puts its highlighted plan there. Reordering here rather
  than in each page's `plans` array keeps the rule in one place — and because
  it reorders the source list, not just the painted columns, tab order and
  screen-reader order follow the layout instead of contradicting it.

  Only a three-plan table is touched, and only when the featured plan is not
  already central.
*/
const ordered = (() => {
  if (plans.length !== 3) return plans;
  const at = plans.findIndex((plan) => plan.featured);
  if (at === -1 || at === 1) return plans;
  const rest = plans.filter((_, index) => index !== at);
  return [rest[0], plans[at], rest[1]];
})();

/*
  Every term's price is formatted here and shipped in the HTML, with all but
  the first hidden. Reformatting in the browser instead would risk a different
  Intl result than the prerender produced (Node and the browser can disagree on
  sq-AL), and switching a term would visibly reflow the number.
*/
const cards = ordered.map((plan) => {
  const termed = hasTerms && plan.price > 0;
  const monthly = formatPriceValue(plan.price, { currency: plan.currency, locale });
  return {
    plan,
    termed,
    prices: terms.map((term) => ({
      months: term.months,
      total: plan.price * term.months,
      unit: term.months === 1 ? plan.unit : term.label,
      sub:
        term.months === 1
          ? `Gjithsej për 1 ${plan.unit}`
          : `${monthly}/${plan.unit} × ${term.months} muaj`,
    })),
  };
});

/*
  Two plans sit side by side at md; three need the wider container and a third
  column, and only get it at lg — three cards at tablet width squeeze the price
  and the feature list into two lines each.
*/
const isTrio = plans.length > 2;
---

<Section class={cn('', className)} data-pricing>
  <SectionContainer class="gap-10">
    <div data-reveal>
      <SectionHeading eyebrow="Çmimet" title={title} description={description} />
    </div>

    {
      hasTerms && (
        <div class="flex flex-col items-center gap-2.5" data-reveal>
          <div
            class="border-border/70 bg-card flex flex-wrap items-center justify-center gap-1 rounded-full border p-1 shadow-sm"
            role="group"
            aria-label="Kohëzgjatja e abonimit"
            data-term-switch
          >
            {terms.map((term, index) => (
              <Button
                type="button"
                variant="ghost"
                data-term-option={term.months}
                aria-pressed={index === 0}
                class="text-muted-foreground hover:text-foreground aria-pressed:bg-primary aria-pressed:text-primary-foreground aria-pressed:hover:bg-primary aria-pressed:hover:text-primary-foreground aria-pressed:shadow-sm rounded-full px-4"
              >
                {term.label}
              </Button>
            ))}
          </div>
          <p class="text-muted-foreground text-sm">
            Paguaj për sa muaj të duash me një transfertë të vetme. Çmimi mujor
            nuk ndryshon.
          </p>
        </div>
      )
    }

    <div
      class={cn(
        'mx-auto grid w-full items-stretch gap-6',
        isTrio ? 'max-w-6xl sm:grid-cols-2 lg:grid-cols-3' : 'max-w-4xl md:grid-cols-2',
        // Room for the featured card to lift without clipping its glow.
        hasFeatured && 'lg:gap-8 lg:py-4'
      )}
      data-stagger
    >
      {
        cards.map(({ plan, termed, prices }) => (
          <div
            class={cn(
              'relative isolate flex flex-col rounded-2xl p-8 transition-transform duration-300',
              !plan.featured && 'lift',
              // `dark` flips the tokens inside, so nested Fulldev primitives
              // (PriceValue writes text-foreground on an inner span) read light
              // on the ink surface instead of dark-on-dark.
              plan.featured
                ? 'dark bg-brand-deep text-white shadow-2xl lg:-my-6 lg:scale-[1.04]'
                : 'bg-card shadow-card ring-border/60 ring-1'
            )}
          >
            {/*
              No glow layer and no lit top edge. The featured card in the
              reference design is one flat colour, and the blurred white pool
              that used to sit behind this one lightened the top-right corner
              enough to read as a gradient — which made the fill look uneven
              rather than deliberate, and muddied the white type over it.
            */}
            {plan.badge && (
              <span
                class={cn(
                  'absolute -top-3 left-1/2 z-10 -translate-x-1/2 rounded-full px-3 py-1 text-xs font-semibold tracking-wide whitespace-nowrap',
                  plan.featured
                    ? 'bg-white text-brand-deep shadow-lg'
                    : 'bg-secondary text-secondary-foreground'
                )}
              >
                {plan.badge}
              </span>
            )}

            <div class="flex flex-col gap-1.5">
              <h3
                class={cn(
                  'text-xs font-bold tracking-[0.14em] uppercase',
                  plan.featured ? 'text-white/85' : 'text-muted-foreground'
                )}
              >
                {plan.name}
              </h3>
              <p
                class={cn(
                  'text-sm',
                  plan.featured ? 'text-white/85' : 'text-muted-foreground'
                )}
              >
                {plan.description}
              </p>
            </div>

            <div class="mt-6">
              {termed ? (
                prices.map((entry, index) => (
                  <div data-term-price={entry.months} hidden={index !== 0}>
                    <Price class="items-baseline">
                      <PriceValue
                        price={entry.total}
                        currency={plan.currency}
                        locale={locale}
                        class={cn(
                          'text-4xl font-bold tracking-tight tabular-nums sm:text-[2.75rem]',
                          plan.featured ? 'text-white' : 'text-foreground'
                        )}
                      />
                      <PriceUnit
                        class={cn(
                          'text-sm font-medium',
                          plan.featured ? 'text-white/85' : 'text-muted-foreground'
                        )}
                      >
                        {/* PriceUnit already renders the leading slash. */}
                        {entry.unit}
                      </PriceUnit>
                    </Price>
                    <p
                      class={cn(
                        'mt-1.5 text-xs',
                        plan.featured ? 'text-white/85' : 'text-muted-foreground'
                      )}
                    >
                      {entry.sub}
                    </p>
                  </div>
                ))
              ) : (
                <div>
                  <Price class="items-baseline">
                    <PriceValue
                      price={plan.price}
                      compareAt={plan.compareAt}
                      currency={plan.currency}
                      locale={locale}
                      class={cn(
                        'text-4xl font-bold tracking-tight tabular-nums sm:text-[2.75rem]',
                        plan.featured ? 'text-white' : 'text-foreground'
                      )}
                    />
                    <PriceUnit
                      class={cn(
                        'text-sm font-medium',
                        plan.featured ? 'text-white/85' : 'text-muted-foreground'
                      )}
                    >
                      {/* PriceUnit already renders the leading slash. */}
                      {plan.unit}
                    </PriceUnit>
                  </Price>
                  {/*
                    Keeps the free card's divider and feature list level with
                    the priced cards, which carry a line of term detail here.
                  */}
                  {hasTerms && (
                    <p class="mt-1.5 text-xs" aria-hidden="true">
                      &nbsp;
                    </p>
                  )}
                </div>
              )}
            </div>

            {/*
              Order: price, then the button, then what you get.

              The button used to sit at the very bottom, under the feature
              list, which on the tallest card put the one thing the section
              exists for below the fold on a laptop. This is the reference
              design's order — decide on the price, act, and read the detail
              only if you want it — and it also stops the lists of different
              lengths from pushing the three buttons to three different
              heights.
            */}
            <div class="mt-7 flex flex-col gap-3">
              <Button
                as="a"
                href={plan.button.href}
                size="lg"
                variant={plan.button.variant ?? (plan.featured ? 'default' : 'outline')}
                data-auth-show={plan.authedButton ? 'anon' : undefined}
                data-term-link={termed ? '' : undefined}
                class={cn(
                  'w-full rounded-full',
                  plan.featured &&
                    'bg-white text-brand-deep hover:bg-white/90 border-transparent shadow-lg'
                )}
              >
                {plan.button.label}
              </Button>

              {
                plan.authedButton && (
                  <Button
                    as="a"
                    href={plan.authedButton.href}
                    size="lg"
                    variant={
                      plan.authedButton.variant ?? (plan.featured ? 'default' : 'outline')
                    }
                    data-auth-show="user"
                    data-term-link={termed ? '' : undefined}
                    class={cn(
                      'w-full rounded-full',
                      plan.featured &&
                        'bg-white text-brand-deep hover:bg-white/90 border-transparent shadow-lg'
                    )}
                  >
                    {plan.authedButton.label}
                  </Button>
                )
              }

              {plan.note && (
                <p
                  class={cn(
                    'text-center text-xs',
                    plan.featured ? 'text-white/85' : 'text-muted-foreground'
                  )}
                >
                  {plan.note}
                </p>
              )}
            </div>

            <div
              class={cn(
                'my-7 h-px w-full',
                plan.featured ? 'bg-white/25' : 'bg-border'
              )}
              aria-hidden="true"
            />

            <p
              class={cn(
                'text-xs font-semibold',
                plan.featured ? 'text-white/85' : 'text-muted-foreground'
              )}
            >
              {plan.price === 0
                ? 'Çfarë përfshihet:'
                : `Çfarë përfshin plani ${plan.name}:`}
            </p>

            <ul class="mt-4 flex flex-1 flex-col gap-3.5">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-3 text-sm">
                  <span
                    class={cn(
                      'mt-px flex size-5 shrink-0 items-center justify-center rounded-full',
                      plan.featured ? 'bg-white text-brand-deep' : 'bg-accent text-primary'
                    )}
                  >
                    <Icon name="check" class="size-3.5" />
                  </span>
                  <span class={plan.featured ? 'text-white' : 'text-foreground/85'}>
                    {feature}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </SectionContainer>
</Section>

<script>
  /*
    Swapping the term shows the matching pre-rendered price and rewrites the
    `muaj` parameter on the plan links, so the term the visitor picked here is
    the one waiting for them at /regjistrohu and /app/abonimi. Links without a
    `plan` parameter (the free card, "Shko te paneli") are left alone.
  */
  document.querySelectorAll<HTMLElement>('[data-pricing]').forEach((scope) => {
    const buttons = Array.from(
      scope.querySelectorAll<HTMLButtonElement>('[data-term-option]')
    );
    if (!buttons.length) return;

    const prices = Array.from(scope.querySelectorAll<HTMLElement>('[data-term-price]'));
    const links = Array.from(scope.querySelectorAll<HTMLAnchorElement>('[data-term-link]'));

    function select(months: string) {
      for (const button of buttons) {
        button.setAttribute('aria-pressed', String(button.dataset.termOption === months));
      }
      for (const price of prices) {
        price.hidden = price.dataset.termPrice !== months;
      }
      for (const link of links) {
        const url = new URL(link.getAttribute('href') ?? '', location.origin);
        if (!url.searchParams.has('plan')) continue;
        url.searchParams.set('muaj', months);
        link.setAttribute('href', `${url.pathname}${url.search}`);
      }
    }

    for (const button of buttons) {
      button.addEventListener('click', () => select(button.dataset.termOption ?? '1'));
    }
  });
</script>
