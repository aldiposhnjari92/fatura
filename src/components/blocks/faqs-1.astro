---
import { cn } from "@/lib/utils"
import {
  Accordion,
  AccordionContent,
  AccordionItem,
  AccordionTrigger,
} from "@/components/ui/accordion"
import { Button } from "@/components/ui/button"
import { Section, SectionContainer } from "@/components/ui/section"
import SectionHeading from "@/components/sections/SectionHeading.astro"

type Props = {
  class?: string
  title: string
  description: string
  faqs: {
    id: string
    question: string
    answer: string
  }[]
  buttons?: {
    label: string
    href: string
    variant?: "default" | "outline" | "secondary" | "ghost"
  }[]
}

const { class: className, title, description, faqs, buttons } = Astro.props
---

<Section class={cn("", className)}>
  {/*
    Two columns rather than a centred heading above a narrow accordion.

    The heading and the "still stuck?" escape hatch hold the left rail and stay
    put while the questions scroll past on the right — so help is always in
    view, and the section stops looking like a FAQ bolted onto the bottom of
    the page.
  */}
  <SectionContainer>
    <div class="grid gap-10 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-16">
      <div class="lg:sticky lg:top-24 lg:self-start" data-reveal>
        <SectionHeading eyebrow="Pyetje" title={title} description={description} align="start" />

        <div class="border-primary/20 bg-accent/40 mt-8 rounded-2xl border p-5">
          <p class="text-sm font-semibold">Nuk e gjete përgjigjen?</p>
          <p class="text-muted-foreground mt-1.5 text-sm leading-relaxed">
            Shkruaj dhe të kthejmë përgjigje brenda ditës.
          </p>
          <a
            href="mailto:aldiposhnjari@gmail.com"
            class="text-primary mt-3 inline-block text-sm font-semibold underline underline-offset-4"
          >
            aldiposhnjari@gmail.com
          </a>
        </div>

        {
          buttons?.length && (
            <div class="mt-6 flex flex-wrap gap-3">
              {buttons.map(({ href, label, ...button }, index) => (
                <Button
                  as="a"
                  href={href}
                  size="lg"
                  class="press"
                  variant={button.variant ?? (index === 0 ? "default" : "secondary")}
                  {...button}
                >
                  {label}
                </Button>
              ))}
            </div>
          )
        }
      </div>

      <div data-reveal>
        <Accordion collapsible>
          {
            faqs.map((item) => (
              <AccordionItem value={item.id}>
                <AccordionTrigger>{item.question}</AccordionTrigger>
                <AccordionContent>{item.answer}</AccordionContent>
              </AccordionItem>
            ))
          }
        </Accordion>
      </div>
    </div>
  </SectionContainer>
</Section>
