---
import type { ImageMetadata } from "astro"

import { cn } from "@/lib/utils"
import {
  Avatar,
  AvatarFallback,
  AvatarGroup,
  AvatarImage,
} from "@/components/ui/avatar"
import { Button } from "@/components/ui/button"
import { Rating } from "@/components/ui/rating"
import { Section, SectionContainer } from "@/components/ui/section"

type Props = {
  class?: string
  title: string
  description: string
  buttons?: {
    label: string
    href: string
    variant?: "default" | "outline" | "secondary" | "ghost"
    /** Show this button only to signed-out ('anon') or signed-in ('user') visitors. */
    'data-auth-show'?: 'anon' | 'user'
  }[]
  socialProof?: {
    avatars: {
      image?: ImageMetadata
      initials: string
      name?: string
    }[]
    rating: number
    text: string
  }
}

const {
  class: className,
  title,
  description,
  buttons,
  socialProof,
} = Astro.props
---

<Section variant="floating" class={cn("", className)}>
  {/*
    The closing band of the reference design is a single filled rectangle with
    a generous radius — the one place on the page where the brand colour takes
    the whole surface. The caller supplies the fill (`class="bg-primary"`); the
    type here is stated in white rather than in tokens, because a token that
    resolves correctly on ink does not necessarily clear AA on brand teal.

    The soft light behind the copy is decorative and sits under the content.
  */}
  <SectionContainer class="relative isolate items-center overflow-hidden py-6 text-center" data-reveal="scale">
    <div
      class="pointer-events-none absolute inset-x-0 -top-32 -z-10 mx-auto size-[28rem] rounded-full bg-white/10 blur-3xl"
      aria-hidden="true"
    >
    </div>

    {
      socialProof && (
        <div class="flex flex-col items-center gap-3">
          <AvatarGroup>
            {socialProof.avatars.map((avatar) => (
              <Avatar class="ring-background size-11 ring">
                <AvatarImage src={avatar.image} alt={avatar.name ?? avatar.initials} />
                <AvatarFallback>{avatar.initials}</AvatarFallback>
              </Avatar>
            ))}
          </AvatarGroup>
          <div class="flex items-center gap-2">
            <Rating value={socialProof.rating} />
            <span class="text-sm text-white/85">{socialProof.text}</span>
          </div>
        </div>
      )
    }

    <div class="flex max-w-2xl flex-col items-center gap-5">
      <h2 class="text-section text-balance text-white">{title}</h2>
      <p class="text-lead text-balance text-white/85">{description}</p>
    </div>

    {
      buttons?.length && (
        <div class="flex flex-wrap justify-center gap-3">
          {buttons.map(({ href, label, ...button }, index) => (
            <Button
              as="a"
              href={href}
              size="lg"
              class="press text-brand-deep rounded-full bg-white px-7 shadow-lg hover:bg-white/90"
              variant={button.variant ?? (index === 0 ? "default" : "secondary")}
              {...button}
            >
              {label}
            </Button>
          ))}
        </div>
      )
    }
  </SectionContainer>
</Section>
