---
import type { ImageMetadata } from "astro"

import { cn } from "@/lib/utils"
import {
  Avatar,
  AvatarFallback,
  AvatarGroup,
  AvatarImage,
} from "@/components/ui/avatar"
import { Button } from "@/components/ui/button"
import { Rating } from "@/components/ui/rating"
import { Section, SectionContainer } from "@/components/ui/section"

type Props = {
  class?: string
  title: string
  description: string
  buttons?: {
    label: string
    href: string
    variant?: "default" | "outline" | "secondary" | "ghost"
    /** Show this button only to signed-out ('anon') or signed-in ('user') visitors. */
    'data-auth-show'?: 'anon' | 'user'
  }[]
  socialProof?: {
    avatars: {
      image?: ImageMetadata
      initials: string
      name?: string
    }[]
    rating: number
    text: string
  }
}

const {
  class: className,
  title,
  description,
  buttons,
  socialProof,
} = Astro.props
---

<Section variant="floating" class={cn("", className)}>
  {/*
    The closing band carries the same aurora + grid as the hero, so the page
    opens and shuts on the same note instead of ending on a flat dark rectangle.
    Both layers are decorative and sit behind the content.
  */}
  <SectionContainer class="relative isolate items-center overflow-hidden text-center" data-reveal="scale">
    <div class="bg-aurora pointer-events-none absolute inset-0 -z-10 opacity-70" aria-hidden="true"></div>
    <div class="bg-grid pointer-events-none absolute inset-0 -z-10 opacity-40" aria-hidden="true"></div>

    {
      socialProof && (
        <div class="flex flex-col items-center gap-3">
          <AvatarGroup>
            {socialProof.avatars.map((avatar) => (
              <Avatar class="ring-background size-11 ring">
                <AvatarImage src={avatar.image} alt={avatar.name ?? avatar.initials} />
                <AvatarFallback>{avatar.initials}</AvatarFallback>
              </Avatar>
            ))}
          </AvatarGroup>
          <div class="flex items-center gap-2">
            <Rating value={socialProof.rating} />
            <span class="text-muted-foreground text-sm">{socialProof.text}</span>
          </div>
        </div>
      )
    }

    <div class="flex max-w-2xl flex-col items-center gap-5">
      <h2 class="text-section text-foreground text-balance">{title}</h2>
      <p class="text-muted-foreground text-lead text-balance">{description}</p>
    </div>

    {
      buttons?.length && (
        <div class="flex flex-wrap justify-center gap-3">
          {buttons.map(({ href, label, ...button }, index) => (
            <Button
              as="a"
              href={href}
              size="lg"
              class="press"
              variant={button.variant ?? (index === 0 ? "default" : "secondary")}
              {...button}
            >
              {label}
            </Button>
          ))}
        </div>
      )
    }
  </SectionContainer>
</Section>
